<style>
  .brain-chips {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    color: #ffffff;
  }

  .body,
  .brain,
  .gyri-mid,
  .gyri path,
  .lens,
  .leader,
  .trace,
  .chip-body,
  .chip-core,
  .chip path {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }

  .body { stroke-width: 1.6; fill: rgba(255, 255, 255, 0.05); opacity: 0.95; }

  .lens { stroke-width: 1.1; stroke-dasharray: 2 4; opacity: 0.55; }
  .lens-big { stroke-width: 1.4; stroke-dasharray: none; opacity: 0.75; fill: rgba(10, 10, 10, 0.85); }
  .leader { stroke-width: 1; stroke-dasharray: 2 4; opacity: 0.4; }

  .brain { stroke-width: 1.4; fill: rgba(255, 255, 255, 0.06); }
  .gyri-mid { stroke-width: 1.1; opacity: 0.8; }
  .gyri path { stroke-width: 1; opacity: 0.55; }

  .trace { stroke-width: 1.2; opacity: 0.4; }
  .via { fill: currentColor; opacity: 0.85; }

  /* Travelling dashes along each trace */
  .flow {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 3 22;
    opacity: 0.95;
    animation: bc-flow 2.6s linear infinite;
  }
  .traces path:nth-of-type(4n + 3) { animation-duration: 3.4s; }

  .chip path { stroke-width: 1.2; opacity: 0.65; }
  .chip-body { stroke-width: 1.5; fill: rgba(10, 10, 10, 0.9); }
  .chip-core { stroke-width: 1.2; fill: rgba(255, 255, 255, 0.14); opacity: 0.9; }
  .chip-main .chip-body { fill: rgba(30, 30, 30, 0.95); }
  .chip-main .chip-core,
  .chip-inset .chip-core { animation: bc-pulse 2.4s ease-in-out infinite; }

  @keyframes bc-flow {
    to { stroke-dashoffset: -50; }
  }
  @keyframes bc-pulse {
    0%, 100% { fill: rgba(255, 255, 255, 0.14); }
    50% { fill: rgba(255, 255, 255, 0.55); }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow { animation: none; opacity: 0; }
    .chip-main .chip-core,
    .chip-inset .chip-core { animation: none; }
  }
</style>
