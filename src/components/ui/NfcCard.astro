---
// KNR NFC card: charcoal card with NFC mark, wordmark, name block and KNR seal.
// Sizes use container-query units (cqw), so it scales cleanly at any width.
interface Props {
  name?: string;
  tagline?: string;
  class?: string;
}
const { name = 'Your Name', tagline = 'Your next connection.', class: className = '' } = Astro.props;
---

<div class={`nfc-card ${className}`} role="img" aria-label={`KNR NFC business card for ${name}`}>
  <span class="sheen" aria-hidden="true"></span>

  <div class="brand">
    <span class="brand-mark">KNR</span>
    <span class="brand-sub">Collective</span>
  </div>

  <svg class="nfc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="1.6"></circle>
    <path class="w w1" d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49"></path>
    <path class="w w2" d="M19.07 4.93a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
  </svg>

  <div class="holder">
    <span class="holder-name">{name}</span>
    <span class="holder-tag">{tagline}</span>
  </div>

  <span class="seal" aria-hidden="true">KNR</span>
</div>

<style>
  .nfc-card {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 1.586 / 1;
    /* ISO/IEC 7810 ID-1: ~3.2mm corners on 85.6 x 54mm */
    border-radius: 3.7% / 5.9%;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(120% 90% at 85% 10%, rgba(255, 255, 255, 0.07), transparent 55%),
      linear-gradient(135deg, #2b2d30 0%, #1c1d1f 52%, #242628 100%);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 30px 60px -20px rgba(0, 0, 0, 0.45),
      0 12px 24px -12px rgba(0, 0, 0, 0.35);
  }

  /* Large arc across the card face */
  .nfc-card::before {
    content: '';
    position: absolute;
    width: 95%;
    aspect-ratio: 1;
    right: -12%;
    top: -42%;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
  }

  .sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.06) 50%, transparent 62%);
    background-size: 220% 100%;
    background-position: 120% 0;
    transition: background-position 1.1s var(--ease-out);
    pointer-events: none;
  }

  .brand {
    position: absolute;
    left: 7.5cqw;
    top: 11cqw;
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
  }

  .brand-mark {
    font-family: var(--font-heading);
    font-size: 8cqw;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 2.4cqw;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .nfc {
    position: absolute;
    right: 7cqw;
    top: 8.5cqw;
    width: 6.4cqw;
    height: 6.4cqw;
    color: rgba(255, 255, 255, 0.85);
  }

  .holder {
    position: absolute;
    left: 7.5cqw;
    bottom: 8cqw;
    display: flex;
    flex-direction: column;
    gap: 0.9cqw;
  }

  .holder-name {
    font-family: var(--font-heading);
    font-size: 3.7cqw;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1;
  }

  .holder-tag {
    font-family: var(--font-mono);
    font-size: 2.3cqw;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .seal {
    position: absolute;
    right: 6cqw;
    bottom: 6.5cqw;
    width: 11cqw;
    height: 11cqw;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.4);
    font-family: var(--font-heading);
    font-size: 2.6cqw;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  /* NFC waves "tap" pulse */
  .w {
    animation: nfc-pulse 2.6s ease-in-out infinite;
  }
  .w2 {
    animation-delay: 0.35s;
  }
  @keyframes nfc-pulse {
    0%, 100% { opacity: 0.35; }
    40% { opacity: 1; }
  }

  @media (hover: hover) {
    .nfc-card:hover .sheen {
      background-position: -20% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w { animation: none; }
    .sheen { transition: none; }
  }
</style>
