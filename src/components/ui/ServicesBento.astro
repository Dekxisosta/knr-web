---
// Services Bento Grid - inspired by bento box layout
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);
---

<div class="services-bento">
  {sortedServices.map((service) => (
    <div class="bento-item">
      <h3 class="bento-title">{service.data.title}</h3>
    </div>
  ))}
</div>

<style>
  .services-bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .bento-item {
    background: rgba(0, 0, 0, 0.5);
    padding: var(--space-4) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 80px;
    position: relative;
    transition: background var(--dur-base) var(--ease-out);
    border-right: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Remove right border on last item */
  .bento-item:last-child {
    border-right: none;
  }

  @media (hover: hover) {
    .bento-item:hover {
      background: rgba(0, 0, 0, 0.7);
    }
  }

  .bento-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-light);
    margin: 0;
    line-height: 1.3;
    text-align: center;
  }

  /* Tablet: 3x2 */
  @media (max-width: 1024px) {
    .services-bento {
      grid-template-columns: repeat(3, 1fr);
      max-width: 800px;
    }
    
    .bento-item {
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    /* Remove right border on every 3rd item */
    .bento-item:nth-child(3n) {
      border-right: none;
    }
    
    /* Remove bottom border on last row */
    .bento-item:nth-last-child(-n+3) {
      border-bottom: none;
    }
  }

  /* Mobile: 2 columns */
  @media (max-width: 640px) {
    .services-bento {
      grid-template-columns: repeat(2, 1fr);
      max-width: 500px;
    }
    
    .bento-item {
      min-height: 70px;
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    /* Remove right border on every 2nd item */
    .bento-item:nth-child(3n) {
      border-right: 1px solid rgba(255, 255, 255, 0.2);
    }
    .bento-item:nth-child(2n) {
      border-right: none;
    }
    
    /* Remove bottom border on last row */
    .bento-item:nth-last-child(-n+3) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }
    .bento-item:nth-last-child(-n+2) {
      border-bottom: none;
    }
    
    .bento-title {
      font-size: 10px;
    }
  }
</style>
