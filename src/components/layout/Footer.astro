---
const year = new Date().getFullYear();
const buildVersion = '0.1.0';

const footerSections = [
  {
    title: 'Services',
    links: [
      { href: '/#services', label: 'Websites' },
      { href: '/#services', label: 'Full-Stack Web Applications' },
      { href: '/#services', label: 'Mobile Applications' },
      { href: '/#services', label: 'Software Maintenance' },
      { href: '/#services', label: 'AI Integration' },
      { href: '/#services', label: 'NFC Business Cards' },
    ]
  },
  {
    title: 'Company',
    links: [
      { href: '/#process', label: 'Process' },
      { href: '/#contact', label: 'Contact' },
    ]
  },
  {
    title: 'Resources',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms of Service' },
    ]
  },
  {
    title: 'Connect',
    links: [
      { href: 'mailto:knrcollective@proton.me', label: 'Email Us' },
      { href: 'https://www.facebook.com/knrcollective/', label: 'Facebook' },
    ]
  }
];
---

<footer class="site-footer">
  <!-- Zipper Aesthetic -->
  <div class="zipper-top">
    <div class="zipper-line">
      <div class="zipper-teeth">
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
        <div class="tooth"></div>
      </div>
      <div class="zipper-slider">
        <div class="slider-pull"></div>
      </div>
    </div>
  </div>

  <div class="section-container">
    <!-- Navigation Links Grid -->
    <div class="footer-nav-grid">
      {footerSections.map(section => (
        <div class="footer-nav-col">
          <h3 class="footer-nav-heading">{section.title}</h3>
          <ul role="list">
            {section.links.map(link => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Section -->
    <div class="footer-bottom">
      <!-- Company Info -->
      <div class="footer-company">
        <div class="company-logo">
          <img src="/images/logo.png" alt="KNR Collective" class="logo-img" />
        </div>
        <div class="company-info">
          <h4 class="company-name">KNR Collective</h4>
          <p class="company-tagline">Secure Software Engineering</p>
          <p class="company-desc">
            We bring together software engineering, thoughtful design, and 
            business strategy to build secure, reliable digital solutions.
          </p>
        </div>
      </div>

      <!-- Social Links -->
      <div class="footer-social">
        <p class="social-heading">Connect with us</p>
        <div class="social-links">
          <a href="https://www.facebook.com/knrcollective/" class="social-link" target="_blank" rel="noopener" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a href="mailto:knrcollective@proton.me" class="social-link" aria-label="Email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m4 4 16 0c1.1 0 2 .9 2 2l0 12c0 1.1-.9 2-2 2l-16 0c-1.1 0-2-.9-2-2l0-12c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-status">
      <div class="status-left">
        <a href="/privacy" class="status-link">Privacy</a>
        <span class="sep">·</span>
        <a href="/terms" class="status-link">Terms</a>
        <span class="sep">·</span>
        <span>© {year} KNR Collective. All rights reserved.</span>
      </div>
      <div class="status-right">
        <button class="back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
          Back to top ↑
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #000;
    color: #ffffff;
    padding-block: 0 var(--space-8);
    margin-top: var(--space-16);
    position: relative;
  }
  @media (min-width: 1024px) {
    .site-footer { 
      padding-bottom: var(--space-8); 
      margin-top: var(--space-24); 
    }
  }

  /* Zipper Aesthetic */
  .zipper-top {
    position: relative;
    width: 100%;
    height: 40px;
    background: linear-gradient(to bottom, transparent 0%, #000 50%);
    overflow: hidden;
  }

  .zipper-line {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .zipper-teeth {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 80px;
  }

  .tooth {
    width: 12px;
    height: 20px;
    background: white;
    border-radius: 2px;
    position: relative;
    transform: skew(-15deg);
    opacity: 0.8;
  }

  .tooth:nth-child(even) {
    transform: skew(15deg);
    opacity: 0.6;
  }

  /* Central zipper line */
  .zipper-line::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: white;
    transform: translateY(-50%);
    z-index: 1;
    opacity: 0.4;
  }

  /* Zipper slider */
  .zipper-slider {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 24px;
    background: white;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    opacity: 0.9;
  }

  .slider-pull {
    width: 16px;
    height: 8px;
    background: #000;
    border-radius: 2px;
    position: relative;
  }

  .slider-pull::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 50%;
    width: 4px;
    height: 4px;
    background: #000;
    border-radius: 50%;
    transform: translateX(-50%);
  }

  .section-container {
    padding-top: var(--space-16);
  }

  @media (min-width: 1024px) {
    .section-container {
      padding-top: var(--space-20);
    }
  }

  /* Navigation Grid */
  .footer-nav-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-12);
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 900px) {
    .footer-nav-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .footer-nav-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-nav-heading {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: #ffffff;
    margin-bottom: var(--space-2);
  }

  .footer-nav-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: #ffffff; /* Improved contrast from #cccccc */
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
    transition: color var(--dur-fast) var(--ease-out);
    text-decoration: none;
  }
  .footer-link:hover { 
    color: #ffffff; 
  }

  /* Bottom Section */
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: start;
    margin-bottom: var(--space-12);
  }

  @media (max-width: 768px) {
    .footer-bottom {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  /* Company Info */
  .footer-company {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (max-width: 480px) {
    .footer-company {
      flex-direction: column;
      gap: var(--space-4);
      text-align: center;
    }
  }

  .company-logo {
    flex-shrink: 0;
  }

  .logo-img {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  .company-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .company-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .company-tagline {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: #ffffff;
    font-weight: 600;
    margin: 0;
  }

  .company-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: #ffffff; /* Improved contrast from #cccccc */
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
    line-height: 1.6;
    max-width: 400px;
    margin: 0;
  }

  /* Social Section */
  .footer-social {
    text-align: right;
  }

  @media (max-width: 768px) {
    .footer-social {
      text-align: center;
    }
  }

  .social-heading {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: #ffffff; /* Improved contrast from #cccccc */
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .social-links {
    display: flex;
    gap: var(--space-4);
    justify-content: flex-end;
  }

  @media (max-width: 768px) {
    .social-links {
      justify-content: center;
    }
  }

  .social-link {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff; /* Improved contrast from #cccccc */
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
    transition: all var(--dur-fast) var(--ease-out);
  }

  .social-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
    transform: translateY(-2px);
  }

  /* Footer Status */
  .footer-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (max-width: 640px) {
    .footer-status {
      flex-direction: column;
      gap: var(--space-4);
      text-align: center;
    }
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: #ffffff; /* Improved contrast from #cccccc */
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
    flex-wrap: wrap;
  }

  .status-link {
    color: #ffffff; /* Improved contrast from #cccccc */
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .status-link:hover {
    color: #ffffff;
  }

  .sep { 
    color: rgba(255, 255, 255, 0.3); 
  }

  .back-to-top {
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff; /* Improved contrast from #cccccc */
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: all var(--dur-fast) var(--ease-out);
  }

  .back-to-top:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.4);
    color: #ffffff;
  }
</style>


