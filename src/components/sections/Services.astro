---
const services = [
  {
    index: '01',
    name: 'Software Development',
    outcome: 'Websites, web applications, custom software, and digital solutions built with security and maintainability in mind.',
  },
  {
    index: '02',
    name: 'Security Auditing',
    outcome: 'Code review and security assessment to identify vulnerabilities, implementation flaws, and technical weaknesses in existing systems.',
  },
  {
    index: '03',
    name: 'Code Remediation',
    outcome: 'Fix security issues, resolve technical debt, and improve code quality based on audit findings.',
  },
  {
    index: '04',
    name: 'System Enhancement',
    outcome: 'Add features, integrate APIs, refactor architecture, and improve existing software systems.',
  },
];
---

<section id="services" class="services-section section-pad" aria-labelledby="services-heading">
  <div class="section-container">

    <header class="section-header">
      <div class="header-badge">Services</div>
      <h2 id="services-heading" class="section-title">
        What we do
      </h2>
      <p class="section-desc">
        Software engineering and security-focused solutions.
      </p>
    </header>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="card-header">
            <span class="service-index">{service.index}</span>
            <h3 class="service-name">{service.name}</h3>
          </div>
          <p class="service-outcome">{service.outcome}</p>
          <div class="card-arrow">→</div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .services-section {
    background: var(--surface);
    position: relative;
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
  }

  .header-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, var(--text-3xl));
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: var(--space-4);
    letter-spacing: -0.03em;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Cards */
  .service-card {
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    position: relative;
    transition: all var(--dur-base) var(--ease-out);
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 40%;
    background: radial-gradient(circle, var(--text-strong) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
    opacity: 0;
    border-radius: 0 var(--radius-lg) 0 0;
    mask-image: radial-gradient(ellipse 60% 60% at 80% 20%, black 20%, transparent 70%);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .service-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
      border-color: var(--text-strong);
    }
    .service-card:hover::before {
      opacity: 0.06;
    }
    .service-card:hover .card-arrow {
      transform: translate(4px, -4px);
    }
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .service-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-3);
    flex-shrink: 0;
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .service-outcome {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .card-arrow {
    font-size: var(--text-xl);
    color: var(--text-strong);
    line-height: 1;
    transition: transform var(--dur-base) var(--ease-out);
  }

  @media (max-width: 640px) {
    .service-card {
      padding: var(--space-6);
    }
    .section-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
    .section-desc {
      font-size: var(--text-base);
    }
  }
</style>
