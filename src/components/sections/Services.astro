---
import Folder from '../ui/Folder.tsx';

const services = [
  {
    index: '01',
    name: 'Software Development',
    color: '#5227FF',
    pages: [
      'Websites, web applications, custom software, and digital solutions built with security and maintainability in mind.',
      'Modern tech stacks with React, TypeScript, Node.js, Python, and cloud platforms.',
      'Responsive design, API development, database architecture, and DevOps integration.',
    ],
  },
  {
    index: '02',
    name: 'Security Auditing',
    color: '#FF6B6B',
    pages: [
      'Code review and security assessment to identify vulnerabilities, implementation flaws, and technical weaknesses in existing systems.',
      'OWASP Top 10 analysis, authentication and authorization review, data protection assessment.',
      'Penetration testing, threat modeling, and comprehensive security reports with actionable recommendations.',
    ],
  },
  {
    index: '03',
    name: 'Code Remediation',
    color: '#4ECDC4',
    pages: [
      'Fix security issues, resolve technical debt, and improve code quality based on audit findings.',
      'Refactoring legacy code, implementing security patches, and upgrading vulnerable dependencies.',
      'Performance optimization, error handling improvements, and documentation updates.',
    ],
  },
  {
    index: '04',
    name: 'System Enhancement',
    color: '#FFD93D',
    pages: [
      'Add features, integrate APIs, refactor architecture, and improve existing software systems.',
      'Third-party service integration, payment gateways, authentication providers, and analytics platforms.',
      'Scalability improvements, microservices architecture, and cloud infrastructure optimization.',
    ],
  },
];
---

<section id="services" class="services-section section-pad" aria-labelledby="services-heading">
  <div class="section-container">

    <header class="section-header">
      <div class="header-badge">Services</div>
      <h2 id="services-heading" class="section-title">
        What we do
      </h2>
      <p class="section-desc">
        Software engineering and security-focused solutions.
      </p>
    </header>

    <div class="services-wrapper">
      <div class="services-grid">
        {services.map((service) => (
          <article class="service-card">
            <div class="folder-container">
              <Folder 
                color={service.color}
                size={1.5}
                pages={service.pages}
                serviceIndex={service.index}
                client:visible
              />
            </div>
            <div class="card-header">
              <span class="service-index">{service.index}</span>
              <h3 class="service-name">{service.name}</h3>
            </div>
            <p class="service-outcome" data-service={service.index}>
              {service.pages[0]}
            </p>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .services-section {
    background: var(--surface);
    position: relative;
    overflow: hidden;
  }

  .services-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--text-strong) transparent;
    transform: rotateX(180deg);
  }

  .services-grid {
    transform: rotateX(180deg);
  }

  /* Webkit scrollbar styling (Chrome, Safari, Edge) */
  .services-wrapper::-webkit-scrollbar {
    height: 12px;
  }

  .services-wrapper::-webkit-scrollbar-track {
    background: transparent;
    margin: 0 var(--space-5);
  }

  .services-wrapper::-webkit-scrollbar-thumb {
    background: var(--text-strong);
    border-radius: 6px;
    transition: background 0.2s ease;
  }

  .services-wrapper::-webkit-scrollbar-thumb:hover {
    background: var(--text-muted);
  }

  /* Hide scrollbar on mobile for cleaner look */
  @media (max-width: 767px) {
    .services-wrapper {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .services-wrapper::-webkit-scrollbar {
      display: none;
    }
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
  }

  .header-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, var(--text-3xl));
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: var(--space-4);
    letter-spacing: -0.03em;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Grid */
  .services-grid {
    display: grid;
    gap: var(--space-6);
    justify-content: start;
    padding-bottom: var(--space-4);
  }

  /* Mobile: 1x4 (single column, 4 rows) */
  @media (max-width: 767px) {
    .services-grid {
      grid-template-columns: 320px;
      grid-template-rows: repeat(4, auto);
      justify-content: center;
    }
  }

  /* Tablet: 2x2 (2 columns, 2 rows) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .services-grid {
      grid-template-columns: repeat(2, 320px);
      grid-template-rows: repeat(2, auto);
      justify-content: center;
    }
  }

  /* Desktop: 4x1 (4 columns, 1 row) */
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(4, 320px);
      grid-template-rows: auto;
      width: max-content;
    }
  }

  /* Cards */
  .service-card {
    width: 320px;
    background: white;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    position: relative;
    transition: all var(--dur-base) var(--ease-out);
    display: flex;
    flex-direction: column;
  }

  .folder-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 180px;
    margin-bottom: var(--space-6);
    position: relative;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 40%;
    background: radial-gradient(circle, var(--text-strong) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
    opacity: 0;
    border-radius: 0 var(--radius-lg) 0 0;
    mask-image: radial-gradient(ellipse 60% 60% at 80% 20%, black 20%, transparent 70%);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .service-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
      border-color: var(--text-strong);
    }
    .service-card:hover::before {
      opacity: 0.06;
    }
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .service-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-3);
    flex-shrink: 0;
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .service-outcome {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
    min-height: 80px;
    transition: opacity 0.2s ease-in-out;
  }

  @media (max-width: 640px) {
    .service-outcome {
      min-height: 60px;
    }
  }

  @media (max-width: 640px) {
    .service-card {
      padding: var(--space-6);
    }
    .section-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
    .section-desc {
      font-size: var(--text-base);
    }
  }
</style>
