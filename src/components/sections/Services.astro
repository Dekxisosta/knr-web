---
import Folder from '../ui/Folder.tsx';

const services = [
  {
    index: '01',
    name: 'Websites',
    outcome: 'Modern, responsive websites built with the latest technologies. From landing pages to complex marketing sites.',
    color: '#5227FF',
  },
  {
    index: '02',
    name: 'Full-Stack Web Applications',
    outcome: 'Complete web applications with robust backends, databases, APIs, and interactive frontends.',
    color: '#FF6B6B',
  },
  {
    index: '03',
    name: 'Mobile Applications',
    outcome: 'Native iOS and Android apps, cross-platform solutions, and progressive web apps designed for performance and user experience.',
    color: '#4ECDC4',
  },
  {
    index: '04',
    name: 'Software Maintenance & Modernization',
    outcome: 'Bug fixes, dependency updates, performance optimization, and ongoing support for existing applications. Perfect for SMEs without dedicated engineering teams.',
    color: '#FFD93D',
  },
  {
    index: '05',
    name: 'AI Integration',
    outcome: 'Integrate artificial intelligence and machine learning capabilities into existing systems and new applications.',
    color: '#9B59B6',
  },
  {
    index: '06',
    name: 'NFC Business Cards',
    outcome: 'Smart business cards with NFC technology for instant digital contact sharing and networking.',
    color: '#FF9F43',
  },
];
---

<section id="services" class="services-section section-pad" aria-labelledby="services-heading">
  <div class="section-container">

    <header class="section-header">
      <div class="header-badge">Services</div>
      <h2 id="services-heading" class="section-title">
        What we do
      </h2>
      <p class="section-desc">
        Modern software solutions from mobile apps to AI-powered systems.
      </p>
    </header>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="folder-container">
            <Folder 
              color={service.color} 
              size={1.5} 
              client:visible
            />
          </div>
          <div class="card-header">
            <span class="service-index">{service.index}</span>
            <h3 class="service-name">{service.name}</h3>
          </div>
          <p class="service-outcome">{service.outcome}</p>
          <svg class="card-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17l10-10"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .services-section {
    background: var(--surface);
    position: relative;
    overflow: hidden;
  }

  /* Halftone background patterns */
  .services-section::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -5%;
    width: 40%;
    height: 50%;
    background: radial-gradient(circle, #000000 1px, transparent 1px);
    background-size: 8px 8px;
    opacity: 0.06;
    pointer-events: none;
    z-index: 1;
    mask-image: radial-gradient(ellipse 60% 70% at 80% 20%, black 20%, transparent 70%);
  }

  .services-section::after {
    content: '';
    position: absolute;
    bottom: -10%;
    left: -5%;
    width: 35%;
    height: 45%;
    background: radial-gradient(circle, #000000 1.2px, transparent 1.2px);
    background-size: 10px 10px;
    opacity: 0.05;
    pointer-events: none;
    z-index: 1;
    mask-image: radial-gradient(ellipse 50% 60% at 20% 80%, black 25%, transparent 65%);
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
    position: relative;
    z-index: 2;
  }

  .header-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: var(--space-4);
    letter-spacing: -0.03em;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
    position: relative;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Cards */
  .service-card {
    background: white;
    border: 4px dashed var(--text-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    position: relative;
    transition: all var(--dur-base) var(--ease-out);
    display: flex;
    flex-direction: column;
    cursor: pointer;
    height: 100%;
    align-self: stretch;
  }

  .folder-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 180px;
    margin-bottom: var(--space-6);
    position: relative;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 40%;
    background: radial-gradient(circle, var(--text-strong) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
    opacity: 0;
    border-radius: 0 var(--radius-lg) 0 0;
    mask-image: radial-gradient(ellipse 60% 60% at 80% 20%, black 20%, transparent 70%);
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .card-arrow {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 24px;
    height: 24px;
    color: var(--text-strong);
    opacity: 0;
    transform: translate(4px, -4px);
    transition: all var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .service-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
      border-style: solid;
    }
    
    .service-card:hover::before {
      opacity: 0.06;
    }

    .service-card:hover .card-arrow {
      opacity: 1;
      transform: translate(0, 0);
    }
  }

  @keyframes dash-shift {
    0% {
      border-style: dashed;
    }
    100% {
      border-style: solid;
    }
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .service-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-3);
    flex-shrink: 0;
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .service-outcome {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .service-card {
      padding: var(--space-6);
    }
    .section-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
    .section-desc {
      font-size: var(--text-base);
    }
  }
</style>
