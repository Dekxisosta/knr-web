---
// Hero section with modern pill design
import HalftoneBackground from '../ui/HalftoneBackground.tsx';
---

<section class="hero" aria-labelledby="hero-headline">
  <!-- Invisible navbar spacer -->
  <div class="navbar-spacer" aria-hidden="true"></div>
  
  <HalftoneBackground client:visible />
  <div class="section-container hero-inner">

    <!-- Main content -->
    <div class="hero-content">
      <!-- Brand pill -->
      <div class="brand-pill" aria-hidden="true">
        <span class="pill-text">KNR Collective</span>
        <div class="pill-dots">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>
      </div>

      <h1 id="hero-headline" class="hero-headline">
        <span class="hero-line">Secure software</span>
        <span class="hero-line hero-line--bold">by design.</span>
      </h1>

      <p class="hero-sub">
        Expert software engineering and security auditing.<br />
        We build systems that are secure from the ground up,<br />
        not patched as an afterthought.
      </p>

      <div class="hero-actions">
        <a href="/#contact" class="btn-primary">
          Start a project
        </a>
        <a href="/#work" class="btn-secondary">
          See our work
        </a>
      </div>

      <div class="trust-line">
        <span class="trust-item">OWASP-aligned</span>
        <span class="trust-separator">•</span>
        <span class="trust-item">Pen-tested</span>
      </div>
    </div>

    <!-- Visual element -->
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-card">
        <picture>
          <source 
            media="(max-width: 768px)" 
            srcset="/images/hero-mobile.webp" 
            width="400" 
            height="400"
          />
          <img 
            src="/images/hero.webp" 
            alt="" 
            class="hero-image"
            width="520"
            height="520"
            loading="eager"
            decoding="async"
          />
        </picture>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 0; /* Remove top padding since we have navbar spacer */
    padding-bottom: var(--space-2);
    position: relative;
    background: var(--bg-dark);
    overflow: hidden;
  }

  /* Invisible spacer to prevent navbar overlap */
  .navbar-spacer {
    height: 100px; /* Increased from 80px for more allowance */
    width: 100%;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .navbar-spacer {
      height: 90px; /* Increased from 70px for more allowance on mobile */
    }
  }

  /* Color-shifting gradient overlays */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 0;
    animation: gradient-shift 8s ease-in-out infinite;
  }

  /* Top-right gradient */
  .hero::before {
    top: 0;
    right: 0;
    width: 60%;
    height: 60%;
    background: radial-gradient(
      ellipse 50% 40% at 80% 20%,
      rgba(255, 215, 0, 0.12) 0%,
      rgba(212, 175, 55, 0.06) 30%,
      transparent 70%
    );
  }

  /* Bottom-left gradient */
  .hero::after {
    bottom: 0;
    left: 0;
    width: 55%;
    height: 55%;
    background: radial-gradient(
      ellipse 45% 35% at 20% 80%,
      rgba(184, 134, 11, 0.1) 0%,
      rgba(255, 215, 0, 0.05) 35%,
      transparent 70%
    );
    animation-delay: 4s;
  }

  /* Hide gradients on tablet and below */
  @media (max-width: 768px) {
    .hero::before,
    .hero::after {
      display: none;
    }
  }

  /* Gradient color shift animation */
  @keyframes gradient-shift {
    0%, 100% {
      filter: hue-rotate(0deg) saturate(1);
    }
    33% {
      filter: hue-rotate(-60deg) saturate(1.4); /* Shift to violet */
    }
    66% {
      filter: hue-rotate(140deg) saturate(1.6); /* Shift to neon blue */
    }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr; /* Reduced from 1.6fr to prevent overlap */
    gap: var(--space-24); /* Increased gap to create more separation */
    align-items: center;
    padding-block: 0;
    position: relative;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-20);
      padding-top: var(--space-16);
    }
  }

  /* ── Brand pill ──────────────────────────────────────── */
  .brand-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    background: transparent;
    border: 1.5px solid var(--text-light);
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-6);
    margin-bottom: var(--space-5); /* Increased from var(--space-3) */
    margin-left: calc(var(--space-6) * -1); /* Negative margin to align inner text with headline */
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.1s forwards;
  }

  .pill-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light);
    letter-spacing: -0.01em;
  }

  .pill-dots {
    display: flex;
    gap: var(--space-2);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: transparent;
    border: 1.5px solid var(--text-light);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* Align all content to the left */
    max-width: none; /* Remove any width constraints */
    margin-bottom: var(--space-8); /* Add bottom margin for breathing room */
  }

  /* ── Headline ──────────────────────────────────────────── */
  .hero-headline {
    font-size: clamp(3.5rem, 10vw, 7.5rem);
    font-weight: 700;
    line-height: 0.9; /* Increased from 0.8 for better readability */
    margin-bottom: var(--space-6); /* Increased from var(--space-3) */
    letter-spacing: -0.05em;
    color: var(--text-light);
  }

  .hero-line {
    display: block;
    font-weight: 400;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.25s forwards;
  }

  .hero-line--bold {
    font-weight: 700;
    animation-delay: 0.4s; /* Back to two lines */
  }

  /* ── Sub ───────────────────────────────────────────────── */
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    color: var(--text-light-muted);
    line-height: 1.4; /* Increased from 1.3 for better readability */
    margin-bottom: var(--space-8); /* Increased from var(--space-5) */
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.55s forwards;
  }

  /* ── Actions ──────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-5); /* Increased from var(--space-3) */
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.7s forwards;
  }

  .btn-primary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    background: var(--text-light);
    color: var(--bg-dark);
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-4) var(--space-8);
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    transition: all var(--dur-base) var(--ease-out);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(255, 255, 255, 0.25);
    }
  }

  .btn-secondary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-light-muted);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .btn-secondary:hover {
    color: var(--text-light);
    text-decoration-color: var(--text-light);
  }

  /* ── Trust line ──────────────────────────────────────────── */
  .trust-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4); /* Increased from var(--space-3) */
    margin-bottom: var(--space-8); /* Increased from var(--space-6) */
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.85s forwards;
  }

  .trust-item {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light-muted);
    letter-spacing: -0.01em;
  }

  .trust-separator {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-light-muted);
    opacity: 0.5;
  }

  /* ── Visual card ──────────────────────────────────────── */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.5s forwards;
    position: relative;
  }

  .visual-card {
    position: absolute;
    width: 140%; /* Reduced from 150% */
    max-width: 850px; /* Reduced from 900px */
    aspect-ratio: 1;
    right: -18%; /* Adjusted from -22% */
    top: 50%;
    transform: translateY(-50%);
  }
  @media (min-width: 1200px) {
    .visual-card {
      width: 145%; /* Reduced from 160% */
      right: -20%; /* Adjusted from -25% */
    }
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  /* Remove old card styles */

  /* ── Keyframes ────────────────────────────────────────── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding-top: 0; /* Remove extra padding since navbar spacer handles clearance */
    }
    .hero-visual {
      order: 2;
      min-height: 250px; /* Further reduced for tablet */
    }
    .visual-card {
      position: relative;
      width: 100%;
      max-width: 600px;
      right: 0;
      left: 0;
      margin: 0 auto;
      top: 0;
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
    }
    .hero-inner {
      padding-top: 0;
      gap: 0; /* No gap between content and visual on mobile */
    }
    .hero-visual {
      min-height: 250px; /* Much smaller height for mobile */
    }
    .visual-card {
      max-width: 400px; /* Smaller max-width for mobile */
    }
    .hero-content {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      order: 1;
    }
    .hero-headline { 
      font-size: clamp(3rem, 15vw, 4rem); 
      margin-bottom: var(--space-2);
      line-height: 0.9;
    }
    .hero-sub { 
      font-size: var(--text-lg); 
      margin-bottom: var(--space-3);
    }
    .hero-actions {
      gap: var(--space-4);
      justify-content: center;
      margin-bottom: var(--space-1);
    }
    .btn-primary {
      padding: var(--space-3) var(--space-6);
      min-height: 48px;
      font-size: var(--text-sm);
    }
    .btn-secondary {
      font-size: var(--text-sm);
    }
    .value-props {
      gap: var(--space-3);
      margin-top: var(--space-3);
      justify-content: center;
    }
    .prop-pill {
      padding: var(--space-2) var(--space-4);
    }
    .prop-label {
      font-size: var(--text-xs);
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .brand-pill,
    .hero-line,
    .hero-sub,
    .hero-actions,
    .trust-line,
    .hero-visual {
      opacity: 1;
      animation: none;
    }
  }
</style>
