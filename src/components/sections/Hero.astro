---
// Hero: exactly one viewport tall. The IDE viewport lives in its own section right below.
import IDEViewport from '../ui/IDEViewport.tsx';
import ServicesBento from '../ui/ServicesBento.astro';
import Hero3D from '../ui/Hero3D.tsx';
---

<section class="hero" aria-labelledby="hero-headline">
  <!-- Monochrome 2.5D vault, masked away from the copy (see Hero3D.tsx) -->
  <Hero3D client:idle />

  <div class="section-container hero-main">
    <div class="hero-split">

      <!-- Left: copy -->
      <div class="hero-content">
        <p class="hero-eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          Software engineering &amp; security auditing
        </p>

        <h1 id="hero-headline" class="hero-headline">
          <span class="hero-line">Secure software</span>
          <span class="hero-line hero-line--bold">by design.</span>
        </h1>

        <p class="hero-sub">
          We build systems that are secure from the ground up,
          not patched as an afterthought.
        </p>

        <div class="hero-actions">
          <a href="/#contact" class="btn-primary">
            Start a project <span aria-hidden="true">↗</span>
          </a>
          <a href="/#work" class="btn-secondary">See our work</a>
        </div>

        <ul class="trust-line" role="list">
          <li class="trust-chip">OWASP-aligned</li>
          <li class="trust-chip">Pen-tested</li>
        </ul>
      </div>

      <!-- Right: image -->
      <div class="hero-image">
        <div class="image-frame">
          <img src="/images/hero.webp" alt="KNR Collective hero illustration" loading="eager" fetchpriority="high" />

          <!-- Decorative audit readout -->
          <div class="audit-card" aria-hidden="true">
            <div class="audit-bar">
              <span class="audit-dot"></span><span class="audit-dot"></span><span class="audit-dot"></span>
              <span class="audit-title">knr audit</span>
            </div>
            <ul class="audit-lines">
              <li><span class="ok">✓</span> dependencies validated</li>
              <li><span class="ok">✓</span> auth flows reviewed</li>
              <li><span class="ok">✓</span> input handling tested</li>
              <li><span class="run">›</span> reporting findings<span class="caret"></span></li>
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Principles row -->
    <ul class="principles" role="list">
      <li class="principle">
        <span class="principle-num">01</span>
        <div>
          <h2 class="principle-title">Designed with threats in mind</h2>
          <p class="principle-text">Security is an engineering requirement from the first commit.</p>
        </div>
      </li>
      <li class="principle">
        <span class="principle-num">02</span>
        <div>
          <h2 class="principle-title">Nothing assumed safe</h2>
          <p class="principle-text">We review generated and third-party code instead of trusting it.</p>
        </div>
      </li>
      <li class="principle">
        <span class="principle-num">03</span>
        <div>
          <h2 class="principle-title">Tested before it ships</h2>
          <p class="principle-text">Implementations and dependencies are verified, not just written.</p>
        </div>
      </li>
    </ul>
  </div>

  <!-- Services strip, pinned to the bottom of the viewport -->
  <div class="section-container hero-services">
    <ServicesBento />
  </div>
</section>

<!-- IDE viewport sits directly below the hero -->
<section class="hero-reveal" aria-label="Development environment preview">
  <!-- Decorative dot-grid texture at the left of the code card (same language as the hero) -->
  <div class="ide-texture" aria-hidden="true"></div>
  <div class="section-container hero-reveal-inner">
    <IDEViewport client:visible />
  </div>
</section>

<style>
  /* ── Hero: exactly one viewport tall ───────────────────── */
  .hero {
    --hero-top: 96px; /* clears the fixed navbar */
    height: 100vh;    /* fallback */
    height: 100dvh;   /* real visible viewport on mobile browsers */
    box-sizing: border-box;
    padding-top: var(--hero-top);
    padding-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    position: relative;
    background: var(--bg-dark);
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .hero { --hero-top: 84px; }
  }

  /* Colour-shifting glow overlays */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  .hero::before {
    top: 0;
    right: 0;
    width: 60%;
    height: 60%;
    background: radial-gradient(
      ellipse 50% 40% at 80% 20%,
      rgba(255, 255, 255, 0.07) 0%,
      rgba(255, 255, 255, 0.03) 30%,
      transparent 70%
    );
  }

  .hero::after {
    bottom: 0;
    left: 0;
    width: 55%;
    height: 55%;
    background: radial-gradient(
      ellipse 45% 35% at 20% 80%,
      rgba(255, 255, 255, 0.06) 0%,
      rgba(255, 255, 255, 0.025) 35%,
      transparent 70%
    );
  }

  @media (max-width: 768px) {
    .hero::before,
    .hero::after { display: none; }
  }

  /* ── Main area takes all remaining height ──────────────── */
  .hero-main {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: 1400px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-8);
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-8);
    align-items: center;
    width: 100%;
    min-height: 0;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    max-width: 640px;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.2s forwards;
  }

  /* ── Eyebrow ───────────────────────────────────────────── */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light-muted);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--text-light);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
  }

  /* ── Headline: scales with both width and height ───────── */
  .hero-headline {
    font-size: clamp(2.25rem, min(5.5vw, 9vh), 4.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text-light);
    margin-bottom: var(--space-4);
  }

  .hero-line {
    display: block;
    font-weight: 400;
  }

  .hero-line--bold {
    font-weight: 700;
    background: linear-gradient(90deg, #ffffff 0%, rgba(255, 255, 255, 0.55) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ── Sub ───────────────────────────────────────────────── */
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(var(--text-base), min(1.6vw, 2.6vh), var(--text-lg));
    color: var(--text-light-muted);
    line-height: 1.65;
    max-width: 30em;
    margin-bottom: var(--space-6);
  }

  /* ── Actions ───────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .btn-primary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    background: var(--text-light);
    color: var(--bg-dark);
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-8);
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(255, 255, 255, 0.25);
    }
  }

  .btn-secondary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-light-muted);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    transition: color var(--dur-fast) var(--ease-out), text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .btn-secondary:hover {
    color: var(--text-light);
    text-decoration-color: var(--text-light);
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 2px solid var(--text-light);
    outline-offset: 4px;
  }

  /* ── Trust chips ───────────────────────────────────────── */
  .trust-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .trust-chip {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light-muted);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-4);
  }

  /* ── Image ─────────────────────────────────────────────── */
  .hero-image {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.45s forwards;
  }

  .image-frame {
    position: relative;
    width: 100%;
    max-width: 520px;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.35),
      rgba(255, 255, 255, 0.12) 40%,
      rgba(255, 255, 255, 0.3)
    );
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 0 80px rgba(255, 255, 255, 0.06);
  }

  .image-frame img {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(46vh, 460px);
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 1px);
  }

  /* ── Audit card (overlaps the image) ───────────────────── */
  .audit-card {
    position: absolute;
    left: -2.5rem;
    bottom: -1.75rem;
    width: 15.5rem;
    background: rgba(10, 10, 10, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    overflow: hidden;
  }

  .audit-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    background: #1c1c1c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .audit-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }

  .audit-title {
    margin-left: auto;
    color: var(--text-light-muted);
    letter-spacing: 0.04em;
  }

  .audit-lines {
    list-style: none;
    margin: 0;
    padding: var(--space-3) var(--space-3) var(--space-3);
    display: grid;
    gap: 6px;
    color: var(--text-light-muted);
  }

  .audit-lines .ok  { color: var(--text-light); margin-right: 6px; }
  .audit-lines .run { color: var(--text-light-muted); margin-right: 6px; }

  .caret {
    display: inline-block;
    width: 6px;
    height: 12px;
    margin-left: 3px;
    vertical-align: -2px;
    background: var(--text-light);
    animation: caret-blink 1.1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% { opacity: 0; }
  }

  /* ── Principles row ────────────────────────────────────── */
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.55s forwards;
  }

  .principle {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-4) var(--space-5);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.03);
  }

  .principle-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-light-muted);
    letter-spacing: 0.08em;
    padding-top: 3px;
  }

  .principle-title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-light);
    margin: 0 0 var(--space-1);
    line-height: 1.3;
  }

  .principle-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-light-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Not enough height or width: drop the row before anything overflows */
  @media (max-width: 900px), (max-height: 820px) {
    .principles { display: none; }
  }

  /* ── Services strip ────────────────────────────────────── */
  .hero-services {
    flex-shrink: 0;
    width: 100%;
    max-width: 1400px;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.7s forwards;
    position: relative;
    z-index: 1;
  }

  /* Align the strip with the hero content edges */
  .hero-services :global(.services-bento) {
    max-width: none;
  }

  /* Not enough room: drop the strip instead of overflowing the viewport */
  @media (max-width: 768px), (max-height: 680px) {
    .hero-services { display: none; }
  }

  /* ── Below tablet landscape: one column, image shown ────────────────
     The hero no longer forces a full viewport here. It is sized by its
     content, so there is no dead space above, between, or below. */
  @media (max-width: 900px) {
    .hero {
      height: auto;
      min-height: 0;
      padding-bottom: var(--space-10);
    }
    .hero-main {
      flex: none;
      justify-content: flex-start;
      gap: 0;
    }
    .hero-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      align-items: start;
    }
    .hero-content {
      max-width: none;
    }
    .hero-image {
      padding-bottom: var(--space-6); /* room for the audit card that overhangs the image */
    }
    .image-frame {
      max-width: none;
    }
    .image-frame img {
      height: clamp(200px, 52vw, 340px);
      max-height: none;
    }
    .audit-card {
      left: var(--space-3);
      bottom: -1.5rem;
      width: 14rem;
    }
  }

  @media (max-width: 640px) {
    .hero { --hero-top: 76px; }
    .hero-eyebrow { margin-bottom: var(--space-3); }
    .hero-headline {
      font-size: clamp(2.4rem, 10.5vw, 3.1rem);
      margin-bottom: var(--space-3);
    }
    .hero-sub {
      margin-bottom: var(--space-5);
    }
    .hero-actions { margin-bottom: var(--space-4); }
    .btn-primary {
      padding: var(--space-3) var(--space-6);
      min-height: 48px;
      font-size: var(--text-sm);
    }
    .btn-secondary { font-size: var(--text-sm); }
  }

  /* ── IDE section below the hero ────────────────────────── */
  @media (max-width: 1100px) {
    .audit-card { left: -1rem; width: 14rem; }
  }

  .hero-reveal {
    position: relative;
    background: var(--bg-dark);
    padding-block: var(--space-6) var(--space-12);
  }

  .hero-reveal-inner {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  /* Left-side texture: drifting dot grid (as in the side margins) plus a soft glow
     (as in the hero), fading out toward the card. Sits behind the card. */
  .ide-texture {
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(50% - 300px);
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 25% 55%, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.025) 40%, transparent 75%),
      radial-gradient(circle, rgba(255, 255, 255, 0.3) 1.5px, transparent 1.6px) 0 0 / 16px 16px;
    -webkit-mask-image:
      linear-gradient(to right, #000 0%, #000 35%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, #000 0%, #000 35%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 18%, #000 82%, transparent 100%);
    mask-composite: intersect;
    animation: ide-texture-drift 1.07s linear infinite;
  }

  @keyframes ide-texture-drift {
    to { background-position: 0 0, 0 16px; }
  }

  @media (max-width: 1000px) {
    .ide-texture { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ide-texture { animation: none; }
  }

  .hero-reveal-inner > :global(*) {
    width: 100%;
    max-width: 1300px;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-image,
    .principles,
    .hero-services {
      opacity: 1;
      animation: none;
    }
    .caret { animation: none; }
  }
</style>
