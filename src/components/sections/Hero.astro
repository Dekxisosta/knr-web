---
// Hero section with modern pill design
---

<section class="hero" aria-labelledby="hero-headline">
  <div class="section-container hero-inner">

    <!-- Main content -->
    <div class="hero-content">
      <!-- Brand pill -->
      <div class="brand-pill" aria-hidden="true">
        <span class="pill-text">KNR Collective</span>
        <div class="pill-dots">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>
      </div>

      <h1 id="hero-headline" class="hero-headline">
        <span class="hero-line">Secure by</span>
        <span class="hero-line hero-line--bold">design.</span>
      </h1>

      <p class="hero-sub">
        Software engineering and<br />
        security auditing.
      </p>

      <div class="hero-actions">
        <a href="/#contact" class="btn-primary">
          Start a project
        </a>
        <a href="/#work" class="btn-secondary">
          See our work
        </a>
      </div>

      <div class="hero-tag">
        @knrcollective
      </div>
    </div>

    <!-- Visual element -->
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-card">
        <div class="card-halftone"></div>
        <div class="card-content">
          <div class="card-icon">↗</div>
        </div>
      </div>
    </div>

  </div>

  <!-- Value props -->
  <div class="value-props section-container">
    <div class="prop-pill">
      <span class="prop-label">Secure by design</span>
    </div>
    <div class="prop-pill">
      <span class="prop-label">Code auditing</span>
    </div>
    <div class="prop-pill">
      <span class="prop-label">Maintainable software</span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 100px;
    padding-bottom: var(--space-16);
    position: relative;
    background: var(--bg-dark);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-20);
    align-items: center;
    padding-block: var(--space-12);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }

  /* ── Brand pill ──────────────────────────────────────── */
  .brand-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    background: transparent;
    border: 1.5px solid var(--text-light);
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-6);
    margin-bottom: var(--space-10);
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.1s forwards;
  }

  .pill-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light);
    letter-spacing: -0.01em;
  }

  .pill-dots {
    display: flex;
    gap: var(--space-2);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: transparent;
    border: 1.5px solid var(--text-light);
  }

  /* ── Headline ──────────────────────────────────────────── */
  .hero-headline {
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 700;
    line-height: 0.9;
    margin-bottom: var(--space-8);
    letter-spacing: -0.05em;
    color: var(--text-light);
  }

  .hero-line {
    display: block;
    font-weight: 400;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.25s forwards;
  }

  .hero-line--bold {
    font-weight: 700;
    animation-delay: 0.4s;
  }

  /* ── Sub ───────────────────────────────────────────────── */
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    color: var(--text-light-muted);
    line-height: 1.3;
    margin-bottom: var(--space-10);
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.55s forwards;
  }

  /* ── Actions ──────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.7s forwards;
  }

  .btn-primary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    background: var(--text-light);
    color: var(--bg-dark);
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-4) var(--space-8);
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    transition: all var(--dur-base) var(--ease-out);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(255, 255, 255, 0.25);
    }
  }

  .btn-secondary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-light-muted);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .btn-secondary:hover {
    color: var(--text-light);
    text-decoration-color: var(--text-light);
  }

  /* ── Tag ───────────────────────────────────────────────── */
  .hero-tag {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-light-muted);
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.85s forwards;
  }

  /* ── Visual card ──────────────────────────────────────── */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.5s forwards;
  }

  .visual-card {
    width: 100%;
    max-width: 520px;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .card-halftone {
    position: absolute;
    top: -20%;
    right: -20%;
    width: 80%;
    height: 80%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.8) 2px, transparent 2px);
    background-size: 16px 16px;
    opacity: 0.15;
    mask-image: radial-gradient(ellipse 60% 60% at 70% 30%, black 20%, transparent 70%);
  }

  .card-content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-icon {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: var(--text-light);
    color: var(--bg-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5rem;
    line-height: 1;
    box-shadow: 0 12px 48px rgba(255, 255, 255, 0.2);
  }

  /* ── Value props ──────────────────────────────────────── */
  .value-props {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-20);
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 1s forwards;
  }

  .prop-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-6);
    transition: all var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .prop-pill:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.4);
      transform: translateY(-2px);
    }
  }

  .prop-label {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light);
  }

  /* ── Keyframes ────────────────────────────────────────── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-visual {
      order: -1;
    }
    .visual-card {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 80px;
      min-height: auto;
    }
    .hero-headline { 
      font-size: clamp(2.5rem, 12vw, 3rem); 
      margin-bottom: var(--space-6);
    }
    .hero-sub { 
      font-size: var(--text-base); 
      margin-bottom: var(--space-8);
    }
    .hero-actions {
      gap: var(--space-4);
    }
    .btn-primary {
      padding: var(--space-3) var(--space-6);
      min-height: 48px;
      font-size: var(--text-sm);
    }
    .btn-secondary {
      font-size: var(--text-sm);
    }
    .value-props {
      gap: var(--space-3);
      margin-top: var(--space-12);
    }
    .prop-pill {
      padding: var(--space-2) var(--space-4);
    }
    .prop-label {
      font-size: var(--text-xs);
    }
    .card-icon {
      width: 100px;
      height: 100px;
      font-size: 3.5rem;
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .brand-pill,
    .hero-line,
    .hero-sub,
    .hero-actions,
    .hero-tag,
    .hero-visual,
    .value-props {
      opacity: 1;
      animation: none;
    }
  }
</style>
