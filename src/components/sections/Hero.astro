---
// Hero section with draggable IDE
import IDEViewport from '../ui/IDEViewport.tsx';
import HalftoneBackground from '../ui/HalftoneBackground.tsx';
import ServicesBento from '../ui/ServicesBento.astro';
---

<section class="hero" aria-labelledby="hero-headline">
  <!-- Invisible navbar spacer -->
  <div class="navbar-spacer" aria-hidden="true"></div>
  
  <HalftoneBackground client:visible />
  <div class="section-container hero-inner">

    <!-- Hero Container with solid background -->
    <div class="hero-container">
      <!-- 50:50 Layout for desktop -->
      <div class="hero-split">
        <!-- Left: Main content -->
        <div class="hero-content">
          <h1 id="hero-headline" class="hero-headline">
            <span class="hero-line">Secure software</span>
            <span class="hero-line hero-line--bold">by design.</span>
          </h1>

          <p class="hero-sub">
            Expert software engineering and security auditing.<br />
            We build systems that are secure from the ground up,<br />
            not patched as an afterthought.
          </p>

          <div class="hero-actions">
            <a href="/#contact" class="btn-primary">
              Start a project
            </a>
            <a href="/#work" class="btn-secondary">
              See our work
            </a>
          </div>

          <div class="trust-line">
            <span class="trust-item">OWASP-aligned</span>
            <span class="trust-separator">•</span>
            <span class="trust-item">Pen-tested</span>
          </div>
        </div>

        <!-- Right: Hero image -->
        <div class="hero-image">
          <img src="/images/hero.webp" alt="KNR Web Hero" loading="eager" />
        </div>
      </div>
    </div>

    <!-- Services Bento Grid -->
    <div class="hero-services">
      <ServicesBento />
    </div>

    <!-- IDE Viewport (bottom) -->
    <div class="hero-visual">
      <IDEViewport client:load />
    </div>

  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 0; /* Remove top padding since we have navbar spacer */
    padding-bottom: var(--space-2);
    position: relative;
    background: var(--bg-dark);
    overflow: hidden;
  }

  /* Invisible spacer to prevent navbar overlap */
  .navbar-spacer {
    height: 100px; /* Increased from 80px for more allowance */
    width: 100%;
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .navbar-spacer {
      height: 90px; /* Increased from 70px for more allowance on mobile */
    }
  }

  /* Color-shifting gradient overlays */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 0;
    animation: gradient-shift 8s ease-in-out infinite;
  }

  /* Top-right gradient */
  .hero::before {
    top: 0;
    right: 0;
    width: 60%;
    height: 60%;
    background: radial-gradient(
      ellipse 50% 40% at 80% 20%,
      rgba(255, 215, 0, 0.12) 0%,
      rgba(212, 175, 55, 0.06) 30%,
      transparent 70%
    );
  }

  /* Bottom-left gradient */
  .hero::after {
    bottom: 0;
    left: 0;
    width: 55%;
    height: 55%;
    background: radial-gradient(
      ellipse 45% 35% at 20% 80%,
      rgba(184, 134, 11, 0.1) 0%,
      rgba(255, 215, 0, 0.05) 35%,
      transparent 70%
    );
    animation-delay: 4s;
  }

  /* Hide gradients on tablet and below */
  @media (max-width: 768px) {
    .hero::before,
    .hero::after {
      display: none;
    }
  }

  /* Gradient color shift animation */
  @keyframes gradient-shift {
    0%, 100% {
      filter: hue-rotate(0deg) saturate(1);
    }
    33% {
      filter: hue-rotate(-60deg) saturate(1.4); /* Shift to violet */
    }
    66% {
      filter: hue-rotate(140deg) saturate(1.6); /* Shift to neon blue */
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    align-items: center;
    padding-block: 0;
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .hero-inner {
      gap: var(--space-12);
      padding-top: var(--space-8);
    }
  }

  /* Hero Container with solid background */
  .hero-container {
    width: 90vw;
    max-width: 1400px;
    background: rgba(255, 255, 255, 0.01);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-10);
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 0.3s forwards;
    position: relative;
  }

  /* Gold strips on sides */
  .hero-container::before,
  .hero-container::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(
      180deg,
      rgba(147, 51, 234, 0.3) 0%,
      rgba(59, 130, 246, 0.35) 33%,
      rgba(212, 175, 55, 0.3) 66%,
      rgba(147, 51, 234, 0.3) 100%
    );
  }

  .hero-container::before {
    left: 0;
    border-top-left-radius: var(--radius-lg);
    border-bottom-left-radius: var(--radius-lg);
  }

  .hero-container::after {
    right: 0;
    border-top-right-radius: var(--radius-lg);
    border-bottom-right-radius: var(--radius-lg);
  }

  @media (max-width: 1024px) {
    .hero-container {
      padding: var(--space-10) var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .hero-container {
      padding: var(--space-8) var(--space-6);
    }
  }

  /* 50:50 Split Layout */
  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
    width: 100%;
    max-width: 1400px;
  }

  /* Tablet: vertical layout */
  @media (max-width: 1024px) {
    .hero-split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    max-width: 600px;
  }

  /* Center content on tablet and below */
  @media (max-width: 1024px) {
    .hero-content {
      align-items: center;
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
    }
  }

  /* Hero Image */
  .hero-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    max-width: 600px;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 1024px) {
    .hero-image {
      max-width: 500px;
      margin: 0 auto;
    }
  }

  /* ── Services Bento ──────────────────────────────────────── */
  .hero-services {
    width: 100%;
    max-width: 1200px;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 1s forwards;
  }

  /* ── Headline ──────────────────────────────────────────── */
  .hero-headline {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-10); /* Increased from var(--space-6) */
    letter-spacing: -0.04em;
    color: var(--text-light);
  }

  .hero-line {
    display: block;
    font-weight: 400;
    opacity: 1;
  }

  .hero-line--bold {
    font-weight: 700;
  }

  /* ── Sub ───────────────────────────────────────────────── */
  .hero-sub {
    font-family: var(--font-body);
    font-size: clamp(var(--text-base), 1.8vw, var(--text-lg));
    color: var(--text-light-muted);
    line-height: 1.7;
    margin-bottom: var(--space-12);
    opacity: 1;
  }

  /* ── Actions ──────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
    opacity: 1;
    justify-content: flex-start;
  }

  /* Center on tablet and below */
  @media (max-width: 1024px) {
    .hero-actions {
      justify-content: center;
    }
  }

  .btn-primary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    background: var(--text-light);
    color: var(--bg-dark);
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-4) var(--space-8);
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    transition: all var(--dur-base) var(--ease-out);
    box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
  }
  @media (hover: hover) {
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(255, 255, 255, 0.25);
    }
  }

  .btn-secondary {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-light-muted);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.3);
    text-underline-offset: 4px;
    transition: all var(--dur-fast) var(--ease-out);
  }
  .btn-secondary:hover {
    color: var(--text-light);
    text-decoration-color: var(--text-light);
  }

  /* ── Trust line ──────────────────────────────────────────── */
  .trust-line {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    margin-bottom: 0;
    opacity: 1;
    justify-content: flex-start;
  }

  /* Center on tablet and below */
  @media (max-width: 1024px) {
    .trust-line {
      justify-content: center;
    }
  }

  .trust-item {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-light-muted);
    letter-spacing: -0.01em;
  }

  .trust-separator {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-light-muted);
    opacity: 0.5;
  }

  /* ── Visual (IDE Viewport) ──────────────────────────────────────── */
  .hero-visual {
    width: 100%;
    max-width: 1300px;
    opacity: 0;
    animation: fade-up var(--dur-slow) var(--ease-out) 1.15s forwards;
  }

  /* ── Keyframes ────────────────────────────────────────── */
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero-inner {
      gap: var(--space-12);
      padding-top: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: auto;
    }
    .hero-inner {
      padding-top: 0;
      gap: var(--space-10);
    }
    .hero-content {
      text-align: center;
    }
    .hero-headline { 
      font-size: clamp(2.25rem, 12vw, 3.5rem); 
      margin-bottom: var(--space-5);
      line-height: 1.05;
    }
    .hero-sub { 
      font-size: var(--text-base); 
      margin-bottom: var(--space-6);
      line-height: 1.6;
    }
    .hero-actions {
      gap: var(--space-4);
      justify-content: center;
      margin-bottom: var(--space-4);
    }
    .btn-primary {
      padding: var(--space-3) var(--space-6);
      min-height: 48px;
      font-size: var(--text-sm);
    }
    .btn-secondary {
      font-size: var(--text-sm);
    }
  }

  /* ── Reduced motion ────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-line,
    .hero-sub,
    .hero-actions,
    .trust-line,
    .hero-visual {
      opacity: 1;
      animation: none;
    }
  }
</style>
