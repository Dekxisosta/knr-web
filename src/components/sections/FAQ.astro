---
const faqs = [
  {
    q: 'What services do you offer?',
    a: 'Software development (websites, web apps, custom software), security auditing (code review and vulnerability assessment), code remediation (fixing security issues), and system enhancement (features, integrations, refactoring).',
  },
  {
    q: 'Are you taking on new projects?',
    a: 'We\'re in the early stages of building KNR Collective. If you have a project inquiry, reach out — we\'ll let you know our current availability and whether we\'re a good fit.',
  },
  {
    q: 'How do you approach security?',
    a: 'Security is treated as an engineering requirement throughout development. We review code, test implementations, validate dependencies, and audit systems rather than assuming generated or third-party code is safe.',
  },
  {
    q: 'What technologies do you work with?',
    a: 'We\'re technology-agnostic. Choices are based on project requirements, maintainability, security, performance, and our ability to deliver an appropriate solution. We don\'t prescribe a stack without understanding the problem first.',
  },
  {
    q: 'Do you have a portfolio of past work?',
    a: 'We\'re currently building our portfolio and preparing case studies. The company is in its pre-launch stage and hasn\'t yet completed client engagements.',
  },
  {
    q: 'How do I get started?',
    a: 'Use the contact form below or email us directly. We\'ll discuss your requirements, answer questions, and determine if we\'re the right fit for your project.',
  },
];
---

<section id="faq" class="faq-section section-pad" aria-labelledby="faq-heading">
  <div class="section-container">

    <header class="section-header">
      <span class="section-index" aria-hidden="true">06</span>
      <h2 id="faq-heading" class="section-title">FAQ</h2>
    </header>

    <dl class="faq-list">
      {faqs.map((item, i) => (
        <div class="faq-item">
          <dt>
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls={`faq-answer-${i}`}
              id={`faq-btn-${i}`}
            >
              <span class="faq-q-text">{item.q}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
          </dt>
          <dd
            class="faq-answer"
            id={`faq-answer-${i}`}
            role="region"
            aria-labelledby={`faq-btn-${i}`}
            hidden
          >
            <p>{item.a}</p>
          </dd>
        </div>
      ))}
    </dl>

  </div>
</section>

<style>
  .faq-section {
    border-top: 1px solid var(--border);
  }

  .section-header {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    margin-bottom: var(--space-8);
  }
  .section-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    padding-top: 6px;
    flex-shrink: 0;
  }
  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #ffffff;
  }

  .faq-list {
    max-width: 760px;
    margin: 0;
    padding: 0;
  }

  .faq-item {
    border-top: 1px solid var(--border);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* Comfortable tap target — min 48px */
    gap: var(--space-4);
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-5) 0;
    min-height: 48px;
    text-align: left;
    transition: color var(--dur-fast) var(--ease-out);
    color: #ffffff;
  }

  /* Icon rotates on open, no gradient */
  @media (hover: hover) {
    .faq-question:hover { color: #ffffff; }
    .faq-question:hover .faq-q-text { color: #ffffff; }
    .faq-question:hover .faq-icon {
      border-color: #ffffff;
      color: #ffffff;
    }
  }

  .faq-q-text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: inherit;
    transition: color var(--dur-fast) var(--ease-out);
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .faq-q-text { font-size: var(--text-base); }
  }

  .faq-icon {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: #cccccc;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--dur-base) var(--ease-out),
                color var(--dur-fast) var(--ease-out);
    line-height: 1;
    border: 1px solid #444444;
  }
  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(45deg);
    color: #ffffff;
    border-color: #ffffff;
  }

  .faq-answer {
    overflow: hidden;
  }
  .faq-answer p {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: #eeeeee;
    line-height: 1.75;
    padding-bottom: var(--space-5);
    max-width: 66ch;
  }
</style>

<script>
  const items = document.querySelectorAll('.faq-item');

  items.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-question');
    const answer = item.querySelector<HTMLElement>('.faq-answer');
    if (!btn || !answer) return;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all others
      items.forEach((other) => {
        const ob = other.querySelector<HTMLButtonElement>('.faq-question');
        const oa = other.querySelector<HTMLElement>('.faq-answer');
        if (ob && oa && ob !== btn) {
          ob.setAttribute('aria-expanded', 'false');
          oa.hidden = true;
        }
      });

      btn.setAttribute('aria-expanded', String(!isOpen));
      answer.hidden = isOpen;
    });
  });
</script>
