---

<section class="tech-stack-section" aria-label="Technologies we work with">
  <div class="marquee-container">
    <div class="marquee-track">
      {technologies.map((tech) => (
        <div class="tech-item">
          <span class="tech-icon" set:html={tech.icon}></span>
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
      {technologies.map((tech) => (
        <div class="tech-item">
          <span class="tech-icon" set:html={tech.icon}></span>
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-stack-section {
    background: var(--bg-dark);
    padding-block: var(--space-12);
    overflow: hidden;
    position: relative;
  }

  .marquee-container {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .marquee-track {
    display: flex;
    gap: var(--space-8);
    animation: marquee 60s linear infinite;
    white-space: nowrap;
    width: calc(200% + var(--space-8));
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: var(--space-3) var(--space-4);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .tech-icon {
    display: flex;
    align-items: center;
    color: white;
  }

  .tech-icon svg {
    width: 20px;
    height: 20px;
    stroke: white;
  }

  .tech-name {
    color: white;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - var(--space-4)));
    }
  }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .tech-stack-section {
      padding-block: var(--space-8);
    }
    
    .tech-item {
      font-size: var(--text-xs);
      padding: var(--space-2) var(--space-3);
      gap: var(--space-1);
    }
    
    .tech-icon svg {
      width: 16px;
      height: 16px;
    }
    
    .marquee-track {
      gap: var(--space-6);
      animation-duration: 50s;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
    
    .marquee-container {
      overflow-x: auto;
      padding-bottom: var(--space-2);
    }
  }
</style>