---
import { getCollection } from 'astro:content';

const founders = (await getCollection('team')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="team" class="team-section" aria-labelledby="team-heading">
  <div class="section-container">

    <header class="section-header">
      <span class="section-index" aria-hidden="true">05</span>
      <h2 id="team-heading" class="section-title">Team</h2>
    </header>

    <p class="team-intro">
      KNR Collective brings together software engineering, thoughtful design, and business strategy to build secure, reliable digital solutions. We believe businesses deserve technology that works as well as it promises.
    </p>

    <div class="team-cards" role="list">
      {founders.map((f) => {
        const d = f.data;
        return (
          <div class="team-card" role="listitem">
            <!-- Large Nickname -->
            <div class="nickname-section">
              <h3 class="nickname">{d.nickname}</h3>
            </div>

            <!-- Photo -->
            <div class="photo-section">
              <div class="member-photo-wrap">
                <img
                  src={d.photo}
                  alt={`${d.name}, ${d.role}`}
                  width="160"
                  height="160"
                  class="member-photo"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <!-- Details -->
            <div class="details-section">
              <div class="member-details">
                <h4 class="member-name">{d.name}</h4>
                <p class="member-role">{d.role}</p>
                <p class="member-focus">{d.focus}</p>
                
                <!-- Links -->
                <nav class="member-links" aria-label={`${d.name}'s links`}>
                  {d.links.github && (
                    <a href={d.links.github} class="member-link" target="_blank" rel="noopener noreferrer" aria-label={`${d.name}'s GitHub`}>
                      <span class="member-link-text">GitHub</span>
                    </a>
                  )}
                  {d.links.linkedin && (
                    <a href={d.links.linkedin} class="member-link" target="_blank" rel="noopener noreferrer" aria-label={`${d.name}'s LinkedIn`}>
                      <span class="member-link-text">LinkedIn</span>
                    </a>
                  )}
                  {d.links.website && (
                    <a href={d.links.website} class="member-link" target="_blank" rel="noopener noreferrer" aria-label={`${d.name}'s Website`}>
                      <span class="member-link-text">Website</span>
                    </a>
                  )}
                  {d.links.email && (
                    <a href={`mailto:${d.links.email}`} class="member-link" aria-label={`Email ${d.name}`}>
                      <span class="member-link-text">Email</span>
                    </a>
                  )}
                </nav>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .team-section {
    padding-block: var(--space-16);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 768px)  { .team-section { padding-block: var(--space-20); } }
  @media (min-width: 1024px) { .team-section { padding-block: var(--space-24); } }

  /* ── Section header ──────────────────────────────── */
  .section-header {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    margin-bottom: var(--space-6);
  }
  .section-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted-light); /* Better contrast on dark background */
    letter-spacing: 0.1em;
    padding-top: 6px;
  }
  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    color: #ffffff;
  }

  .team-intro {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted-light); /* Better contrast on dark background */
    max-width: 70ch;
    margin-bottom: var(--space-12);
    line-height: 1.7;
    border-left: 1px solid var(--border);
    padding-left: var(--space-5);
  }

  /* ── Team Cards ──────────────────────────────────── */
  .team-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .team-card {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.01);
    transition: all var(--dur-fast) var(--ease-out);
    position: relative;
    /* Notch corners */
    clip-path: polygon(
      0 0,
      calc(100% - 20px) 0,
      100% 20px,
      100% 100%,
      20px 100%,
      0 calc(100% - 20px)
    );
    /* Double border effect */
    box-shadow: inset 0 0 0 3px rgba(255,255,255,0.3);
  }

  @media (hover: hover) {
    .team-card:hover {
      background: rgba(255,255,255,0.03);
      border-color: #ffffff;
      box-shadow: inset 0 0 0 3px rgba(255,255,255,0.6);
    }
    /* Electric gradient border on top edge */
    .team-card:hover::after {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: var(--grad-electric-stripe-h);
      opacity: 0.85;
      /* Match the notch clip-path */
      clip-path: polygon(
        0 0,
        calc(100% - 20px) 0,
        100% 100%,
        0 100%
      );
    }
  }

  /* ── Nickname Section ────────────────────────────── */
  .nickname-section {
    flex: 0 0 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nickname {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.05em;
    margin: 0;
    text-transform: uppercase;
    line-height: 0.9;
  }

  /* ── Photo Section ───────────────────────────────── */
  .photo-section {
    flex: 0 0 160px;
    display: flex;
    justify-content: center;
  }

  .member-photo-wrap {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--surface-2);
    border: 3px dashed rgba(212, 175, 55, 0.4);
    transition: border-color var(--dur-fast) var(--ease-out);
    position: relative;
  }
  
  /* Add subtle notch effect around the circular photo */
  .member-photo-wrap::before {
    content: '';
    position: absolute;
    top: -6px;
    left: -6px;
    right: -6px;
    bottom: -6px;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
    clip-path: polygon(
      0 0,
      calc(100% - 8px) 0,
      100% 8px,
      100% calc(100% - 8px),
      calc(100% - 8px) 100%,
      8px 100%,
      0 calc(100% - 8px),
      0 8px
    );
    z-index: -1;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  
  .member-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter var(--dur-base) var(--ease-out);
  }
  
  @media (hover: hover) {
    .team-card:hover .member-photo {
      filter: grayscale(60%) contrast(1.05) brightness(1.05);
    }
    .team-card:hover .member-photo-wrap {
      border-color: rgba(212, 175, 55, 0.8);
    }
    .team-card:hover .member-photo-wrap::before {
      opacity: 1;
    }
  }

  /* ── Details Section ─────────────────────────────── */
  .details-section {
    flex: 1;
    min-width: 0; /* Allow flex items to shrink below content size */
  }

  .member-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .member-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .member-role {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: #ffffff; /* Improved contrast from #cccccc */
    margin: 0;
  }

  .member-focus {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: #ffffff; /* Improved contrast from #eeeeee */
    line-height: 1.5;
    margin: 0;
    opacity: 0.9; /* Subtle distinction while maintaining contrast */
  }

  /* ── Links ────────────────────────────────────────── */
  .member-links {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  
  .member-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #ffffff;
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 2px;
    transition: all var(--dur-fast) var(--ease-out);
    background: rgba(255, 255, 255, 0.05);
  }
  
  .member-link:hover {
    color: #ffffff;
    border-color: rgba(212, 175, 55, 0.7);
    background: rgba(212, 175, 55, 0.15);
  }

  .member-link-text {
    font-size: inherit;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 900px) {
    .team-card {
      gap: var(--space-6);
    }
    
    .nickname-section {
      flex: 0 0 120px;
    }
    
    .nickname {
      font-size: 2.5rem;
    }
    
    .photo-section {
      flex: 0 0 120px;
    }
    
    .member-photo-wrap {
      width: 120px;
      height: 120px;
    }
  }

  @media (max-width: 640px) {
    .team-card {
      flex-direction: column;
      text-align: center;
      gap: var(--space-6);
    }
    
    .nickname-section,
    .photo-section,
    .details-section {
      flex: none;
    }
    
    .nickname {
      font-size: 3rem;
    }
    
    .member-details {
      align-items: center;
    }
    
    .member-links {
      justify-content: center;
    }
  }
</style>
