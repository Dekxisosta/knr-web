---
const benefits = [
  {
    title: 'Security by design',
    body: 'We treat security as an engineering requirement throughout development, not as an afterthought.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  },
  {
    title: 'Code you can trust',
    body: 'Every line is reviewed, tested, and validated. We don\'t ship code without verification.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
  },
  {
    title: 'Built to last',
    body: 'Clean architecture, maintainable code, and technical decisions based on engineering requirements.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
  },
  {
    title: 'Practical engineering',
    body: 'Technology choices driven by requirements, not trends. Solutions that solve actual problems.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  },
];
---

<section id="why" class="why-section section-pad" aria-labelledby="why-heading">
  <div class="section-container">

    <header class="section-header">
      <h2 id="why-heading" class="section-title">
        How we work
      </h2>
      <p class="section-desc">
        Engineering-focused software development with security and reliability at the core.
      </p>
    </header>

    <div class="benefits-grid">
      {benefits.map((benefit) => (
        <article class="benefit-card">
          <div class="benefit-icon-wrap" set:html={benefit.icon}>
          </div>
          <h3 class="benefit-title">{benefit.title}</h3>
          <p class="benefit-body">{benefit.body}</p>
        </article>
      ))}
    </div>

    <!-- Quote --><div class="quote-card">
      <p class="quote-text">
        "Secure software. Efficient development."
      </p>
      <div class="quote-author">
        <div class="author-badge">Core Message</div>
      </div>
    </div>

  </div>
</section>

<style>
  .why-section {
    position: relative;
    background: var(--bg-dark);
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
    text-align: center;
    margin-inline: auto;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, var(--text-3xl));
    font-weight: 700;
    color: var(--text-light);
    margin-bottom: var(--space-5);
    letter-spacing: -0.03em;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-light-muted);
    line-height: 1.6;
    max-width: 600px;
    margin-inline: auto;
  }

  /* Benefits Grid */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-16);
  }

  @media (max-width: 640px) {
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }

  .benefit-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    transition: all var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .benefit-card:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.2);
      transform: translateY(-4px);
    }
  }

  .benefit-icon-wrap {
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }

  .benefit-icon-wrap svg {
    width: 32px;
    height: 32px;
    color: white;
  }

  .benefit-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-light);
    margin-bottom: var(--space-3);
    letter-spacing: -0.02em;
  }

  .benefit-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-light-muted);
    line-height: 1.7;
  }

  /* Quote Card */
  .quote-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-12);
    max-width: 800px;
    margin-inline: auto;
    position: relative;
  }

  .quote-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 30%;
    height: 30%;
    background: radial-gradient(circle, var(--text-strong) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
    opacity: 0.06;
    border-radius: var(--radius-lg) 0 0 0;
    mask-image: radial-gradient(ellipse 60% 60% at 20% 20%, black 20%, transparent 70%);
  }

  .quote-text {
    font-family: var(--font-heading);
    font-size: clamp(var(--text-lg), 3vw, var(--text-xl));
    font-weight: 500;
    color: var(--text-strong);
    line-height: 1.4;
    margin-bottom: var(--space-6);
    position: relative;
  }

  .quote-author {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .author-badge {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
  }

  @media (max-width: 640px) {
    .section-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
    .section-desc {
      font-size: var(--text-base);
    }
    .quote-card {
      padding: var(--space-8);
    }
    .quote-text {
      font-size: var(--text-md);
    }
  }
</style>
