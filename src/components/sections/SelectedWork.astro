---
import { getCollection } from 'astro:content';

const allWork = await getCollection('work');
const featured = allWork
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
---

<section id="work" class="work-section" aria-labelledby="work-heading">
  <div class="section-container">

    <header class="section-header">
      <span class="section-index" aria-hidden="true">03</span>
      <h2 id="work-heading" class="section-title">Selected Work</h2>
      <p class="section-desc">Projects we can talk about.</p>
    </header>

    {featured.length === 0 ? (
      <p class="work-empty">
        [Case studies coming soon — publishPermission pending from clients.]
      </p>
    ) : (
      <ul class="work-list" role="list">
        {featured.map((project) => (
          <li class="work-item">
            <a href={`/work/${project.data.slug}`} class="work-link" aria-label={`View case study: ${project.data.title}`}>
              <div class="work-meta">
                <span class="work-type">{project.data.type}</span>
                <span class="work-year">{project.data.year}</span>
              </div>
              <div class="work-body">
                <div class="work-info">
                  <h3 class="work-title">{project.data.title}</h3>
                  <p class="work-client">{project.data.client}</p>
                  <p class="work-problem">{project.data.problem}</p>
                  <p class="work-outcome">{project.data.outcome}</p>
                </div>
                <span class="work-cta" aria-hidden="true">View case →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="work-footer">
      <a href="/work" class="work-all-link">All projects →</a>
    </div>

  </div>
</section>

<style>
  .work-section {
    padding-block: var(--space-16);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 768px)  { .work-section { padding-block: var(--space-20); } }
  @media (min-width: 1024px) { .work-section { padding-block: var(--space-24); } }

  /* ── Section header ──────────────────────────────── */
  .section-header {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    margin-bottom: var(--space-8);
  }
  .section-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    padding-top: 6px;
    flex-shrink: 0;
  }
  .section-title {
    font-size: clamp(var(--text-md), 3vw, var(--text-lg));
    color: var(--text-strong);
  }
  .section-desc {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-1);
    max-width: 52ch;
  }

  /* ── Work list ───────────────────────────────────── */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .work-item {
    border-top: 1px solid var(--border);
  }
  .work-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .work-link {
    display: block;
    padding: var(--space-6) 0;
    position: relative;
    transition: background var(--dur-fast) var(--ease-out);
  }
  @media (min-width: 768px) { .work-link { padding: var(--space-8) 0; } }

  @media (hover: hover) {
    .work-link:hover {
      background: rgba(255,255,255,0.015);
    }
    .work-link:hover .work-cta {
      opacity: 1;
      transform: translateX(0);
    }
    .work-link:hover .work-title {
      color: var(--text-strong);
    }
    /* Electric left-border on row hover */
    .work-link:hover::before {
      content: '';
      position: absolute;
      left: -1px;
      top: 0;
      bottom: 0;
      width: 2px;
      background: var(--grad-electric-stripe);
      opacity: 0.7;
    }
  }

  .work-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .work-body {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .work-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .work-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text);
    transition: color var(--dur-fast) var(--ease-out);
    letter-spacing: -0.02em;
  }

  .work-client {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: none;
  }

  .work-problem {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 60ch;
    margin-top: var(--space-2);
  }

  .work-outcome {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
    max-width: 60ch;
  }

  .work-cta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-strong);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    flex-shrink: 0;
    align-self: flex-end;
  }

  .work-empty {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: var(--space-8);
    max-width: none;
  }

  .work-footer {
    margin-top: var(--space-8);
    display: flex;
    justify-content: flex-end;
  }
  .work-all-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .work-all-link:hover { color: var(--text-strong); }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 600px) {
    .work-cta { display: none; }
    .work-body { flex-direction: column; align-items: flex-start; }
  }
</style>
