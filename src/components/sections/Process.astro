---
const steps = [
  {
    index: '01',
    phase: 'Understand',
    description:
      'Discuss your requirements, review existing systems, identify goals and constraints.',
    timeframe: 'Initial',
  },
  {
    index: '02',
    phase: 'Plan',
    description:
      'Define scope, technical approach, and deliverables. Agree on what will be built.',
    timeframe: 'Scoping',
  },
  {
    index: '03',
    phase: 'Build',
    description:
      'Develop, review, test, and validate. Security and correctness at every step.',
    timeframe: 'Development',
  },
  {
    index: '04',
    phase: 'Deliver',
    description:
      'Deploy, document, and hand off working software with confidence.',
    timeframe: 'Completion',
  },
];
---

<section id="process" class="process-section section-pad" aria-labelledby="process-heading">
  <div class="section-container">

    <header class="section-header">
      <div class="header-badge">Process</div>
      <h2 id="process-heading" class="section-title">
        How we work
      </h2>
      <p class="section-desc">
        From idea to production in four clear phases.
      </p>
    </header>

    <div class="process-grid">
      {steps.map((step) => (
        <article class="process-card">
          <div class="card-header">
            <span class="step-index">{step.index}</span>
            <span class="step-timeframe">{step.timeframe}</span>
          </div>
          <h3 class="step-phase">{step.phase}</h3>
          <p class="step-desc">{step.description}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .process-section {
    background: var(--bg);
    position: relative;
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
  }

  .header-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, var(--text-3xl));
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: var(--space-4);
    letter-spacing: -0.03em;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Grid */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
  }

  @media (max-width: 900px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Cards */
  .process-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: all var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .process-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
      border-color: var(--text-strong);
    }
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-3);
  }

  .step-timeframe {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .step-phase {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .process-card {
      padding: var(--space-6);
    }
    .section-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
    .section-desc {
      font-size: var(--text-base);
    }
    .step-phase {
      font-size: var(--text-lg);
    }
  }
</style>
