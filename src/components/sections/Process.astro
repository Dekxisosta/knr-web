---
const steps = [
  {
    index: '01',
    phase: 'Understand',
    description:
      'Discuss your requirements, review existing systems, identify goals and constraints.',
    timeframe: 'Initial',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11H1l6-6 6 6z"/><path d="M9 17l3 3 3-3"/><path d="M22 18.5V2l-3 3-3-3v16.5"/></svg>',
  },
  {
    index: '02',
    phase: 'Plan',
    description:
      'Define scope, technical approach, and deliverables. Agree on what will be built.',
    timeframe: 'Scoping',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>',
  },
  {
    index: '03',
    phase: 'Build',
    description:
      'Develop, review, test, and validate. Security and correctness at every step.',
    timeframe: 'Development',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  },
  {
    index: '04',
    phase: 'Deliver',
    description:
      'Deploy, document, and hand off working software with confidence.',
    timeframe: 'Completion',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><polyline points="7.5 4.21 12 6.81 16.5 4.21"/><polyline points="7.5 19.79 7.5 14.6 3 12"/><polyline points="21 12 16.5 14.6 16.5 19.79"/><polyline points="12 22.81 12 17.8"/></svg>',
  },
];

const principles = [
  {
    title: 'Security by design',
    body: 'We treat security as an engineering requirement throughout development, not as an afterthought.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  },
  {
    title: 'Code you can trust',
    body: 'Every line is reviewed, tested, and validated. We don\'t ship code without verification.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
  },
  {
    title: 'Built to last',
    body: 'Clean architecture, maintainable code, and technical decisions based on engineering requirements.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
  },
  {
    title: 'Practical engineering',
    body: 'Technology choices driven by requirements, not trends. Solutions that solve actual problems.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  },
];
---

<section id="process" class="process-section section-pad" aria-labelledby="process-heading">
  <div class="section-container">

    <header class="section-header">
      <div class="header-badge">Process</div>
      <h2 id="process-heading" class="section-title">
        How we work
      </h2>
      <p class="section-desc">
        Engineering-focused software development with security and reliability at the core.
      </p>
    </header>

    <!-- Process Steps -->
    <div class="process-timeline">
      {steps.map((step, index) => (
        <>
          <article class="process-card" data-step={index + 1}>
            <div class="step-icon-mobile" set:html={step.icon}></div>
            <div class="card-header">
              <span class="step-index">{step.index}</span>
              <span class="step-timeframe">{step.timeframe}</span>
            </div>
            <h3 class="step-phase">{step.phase}</h3>
            <p class="step-desc">{step.description}</p>
            <div class="step-icon-center" set:html={step.icon}></div>
          </article>
        </>
      ))}
    </div>

    <!-- Principles Section -->
    <div class="principles-wrapper">
      <h3 class="principles-heading">Our principles</h3>
      <div class="principles-grid">
        {principles.map((principle) => (
          <div 
            class="principle-circle"
            data-title={principle.title}
            data-description={principle.body}
          >
            <div class="principle-icon-wrap" set:html={principle.icon}></div>
            <h4 class="principle-title">{principle.title}</h4>
          </div>
        ))}
      </div>
      <div class="tooltip" id="principle-tooltip">
        <div class="tooltip-content"></div>
      </div>
    </div>

  </div>
</section>

<style>
  .process-section {
    background: var(--bg);
    position: relative;
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-16);
  }

  .header-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: var(--space-4);
    letter-spacing: -0.03em;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Timeline Zigzag Layout */
  .process-timeline {
    max-width: 900px;
    margin-inline: auto;
    position: relative;
    padding-block: var(--space-8);
  }

  /* Central vertical line */
  .process-timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
    transform: translateX(-50%);
  }

  /* Cards */
  .process-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition: all var(--dur-base) var(--ease-out);
    width: calc(50% - var(--space-12));
    position: relative;
    margin-bottom: var(--space-12);
  }

  /* Step Icon */
  .step-icon {
    width: 48px;
    height: 48px;
    background: var(--text-strong);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-2);
  }

  .step-icon svg {
    width: 24px;
    height: 24px;
    color: white;
  }

  /* Alternate left and right */
  .process-card[data-step="1"] {
    margin-right: auto;
  }

  .process-card[data-step="2"] {
    margin-left: auto;
  }

  .process-card[data-step="3"] {
    margin-right: auto;
  }

  .process-card[data-step="4"] {
    margin-left: auto;
    margin-bottom: 0;
  }

  /* Mobile icon inside cards (hidden on desktop) */
  .step-icon-mobile {
    width: 48px;
    height: 48px;
    background: var(--text-strong);
    border-radius: var(--radius-md);
    display: none;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .step-icon-mobile:hover {
    transform: rotate(45deg);
  }

  .step-icon-mobile svg {
    width: 24px;
    height: 24px;
    color: white;
    stroke: white;
    fill: none;
  }

  /* Connection dots with icons on center line */
  .step-icon-center {
    position: absolute;
    width: 48px;
    height: 48px;
    background: var(--text-strong);
    border: 4px solid var(--bg);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .step-icon-center:hover {
    transform: translateY(-50%) rotate(45deg);
  }

  .step-icon-center svg {
    width: 24px;
    height: 24px;
    color: white;
    stroke: white;
    fill: none;
  }

  .process-card[data-step="1"] .step-icon-center,
  .process-card[data-step="3"] .step-icon-center {
    right: calc(-1 * var(--space-12) - 24px);
  }

  .process-card[data-step="2"] .step-icon-center,
  .process-card[data-step="4"] .step-icon-center {
    left: calc(-1 * var(--space-12) - 24px);
  }

  /* Connecting lines from card to center dot */
  .process-card::before {
    content: '';
    position: absolute;
    height: 2px;
    background: var(--border-strong);
    opacity: 0.3;
    top: 50%;
    transform: translateY(-50%);
  }

  .process-card[data-step="1"]::before,
  .process-card[data-step="3"]::before {
    left: 100%;
    width: var(--space-12);
  }

  .process-card[data-step="2"]::before,
  .process-card[data-step="4"]::before {
    right: 100%;
    width: var(--space-12);
  }

  @media (hover: hover) {
    .process-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
      border-color: #ffffff;
      background: #000;
    }
    
    /* Change text colors when card is hovered */
    .process-card:hover .step-phase {
      color: #ffffff;
    }
    
    .process-card:hover .step-desc {
      color: #cccccc;
    }
    
    .process-card:hover .step-index {
      background: #ffffff;
      color: #000;
      border-color: #ffffff;
    }
    
    .process-card:hover .step-timeframe {
      color: #ffffff;
    }
    
    /* Make center icon more prominent on hover */
    .process-card:hover .step-icon-center {
      background: #ffffff;
      border-color: #000;
    }
    
    .process-card:hover .step-icon-center svg {
      color: #000;
      stroke: #000;
    }
    
    /* Make connecting line more visible */
    .process-card:hover::before {
      background: #ffffff;
      opacity: 0.8;
    }
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-3);
  }

  .step-timeframe {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .step-phase {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* Principles Wrapper */
  .principles-wrapper {
    margin-top: var(--space-24);
    padding-top: var(--space-20);
    border-top: 2px solid var(--border);
  }

  .principles-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--text-strong);
    text-align: center;
    margin-bottom: var(--space-12);
    letter-spacing: -0.03em;
  }

  /* Principles Grid */
  .principles-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .principles-grid {
      gap: var(--space-6);
    }
  }

  .principle-circle {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    cursor: pointer;
    transition: all var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .principle-circle:hover {
      transform: translateY(-4px);
    }
  }

  .principle-icon-wrap {
    width: 80px;
    height: 80px;
    background: white;
    border: 2px solid var(--border);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .principle-circle:hover .principle-icon-wrap {
      border-color: var(--text-strong);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    }
  }

  .principle-icon-wrap svg {
    width: 32px;
    height: 32px;
    color: var(--text-strong);
  }

  .principle-title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-strong);
    text-align: center;
    letter-spacing: -0.02em;
  }

  /* Tooltip */
  .tooltip {
    position: fixed;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transform: translateY(10px);
    transition: all var(--dur-fast) var(--ease-out);
  }

  .tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .tooltip-content {
    background: var(--text-strong);
    color: white;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: 1.5;
    max-width: 280px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .tooltip-content::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 20px;
    width: 12px;
    height: 12px;
    background: var(--text-strong);
    transform: rotate(45deg);
  }

  @media (max-width: 768px) {
    .process-timeline::before {
      display: none;
    }

    .process-card {
      width: 100%;
      margin-left: 0 !important;
      margin-right: 0 !important;
      margin-bottom: var(--space-8);
    }

    .process-card::before {
      display: none;
    }
    
    .step-icon-center {
      display: none;
    }

    .step-icon-mobile {
      display: flex;
    }
  }

  @media (max-width: 640px) {
    .process-card {
      padding: var(--space-6);
    }
    .section-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
    .section-desc {
      font-size: var(--text-base);
    }
    .step-phase {
      font-size: var(--text-lg);
    }
    .principles-wrapper {
      margin-top: var(--space-16);
      padding-top: var(--space-16);
    }
    .principles-heading {
      font-size: var(--text-xl);
      margin-bottom: var(--space-8);
    }
    .principle-card {
      padding: var(--space-6);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.getElementById('principle-tooltip');
    const tooltipContent = tooltip?.querySelector('.tooltip-content');
    const principleCircles = document.querySelectorAll('.principle-circle');

    if (!tooltip || !tooltipContent) return;

    principleCircles.forEach(circle => {
      circle.addEventListener('mouseenter', (e) => {
        const target = e.currentTarget as HTMLElement;
        const description = target.dataset.description;
        
        if (description && tooltipContent) {
          tooltipContent.textContent = description;
          tooltip.classList.add('visible');
        }
      });

      circle.addEventListener('mouseleave', () => {
        tooltip.classList.remove('visible');
      });

      circle.addEventListener('mousemove', (e) => {
        if (tooltip.classList.contains('visible')) {
          const x = e.clientX + 20;
          const y = e.clientY - 10;
          
          tooltip.style.left = `${x}px`;
          tooltip.style.top = `${y}px`;
        }
      });
    });
  });
</script>