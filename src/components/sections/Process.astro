---
import Process3D from '../ui/Process3D.tsx';

const steps = [
  {
    index: '01',
    phase: 'Understand',
    timeframe: 'Initial',
    description: 'We dig into your goals, constraints, and any existing systems before writing a line of code.',
    deliverable: 'Requirements brief',
  },
  {
    index: '02',
    phase: 'Plan',
    timeframe: 'Scoping',
    description: 'We define the scope and technical approach, and agree exactly what will be built.',
    deliverable: 'Scope & approach',
  },
  {
    index: '03',
    phase: 'Build',
    timeframe: 'Development',
    description: 'We develop, review, test, and validate, with security and correctness checked at every step.',
    deliverable: 'Reviewed, tested code',
  },
  {
    index: '04',
    phase: 'Deliver',
    timeframe: 'Completion',
    description: 'We deploy, document, and hand off working software you can confidently run.',
    deliverable: 'Live & documented',
  },
];

const icon = (body: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;

const principles = [
  {
    title: 'Security by design',
    body: 'A requirement from day one, not an afterthought.',
    icon: icon('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>'),
  },
  {
    title: 'Code you can trust',
    body: 'Every line reviewed, tested, and validated before it ships.',
    icon: icon('<polyline points="20 6 9 17 4 12"/>'),
  },
  {
    title: 'Built to last',
    body: 'Clean architecture and maintainable code.',
    icon: icon('<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>'),
  },
  {
    title: 'Practical engineering',
    body: 'Technology chosen by requirements, not trends.',
    icon: icon('<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>'),
  },
];
---

<section id="process" class="process-section section-pad" aria-labelledby="process-heading">
  <!-- Monochrome 2.5D background (loads when the section nears the viewport) -->
  <Process3D client:visible />

  <div class="section-container">

    <header class="section-header" data-parallax="-0.04">
      <div class="header-badge">Process</div>
      <h2 id="process-heading" class="section-title">
        How we work
      </h2>
      <p class="section-desc">
        Engineering-focused development with security and reliability at the core.
      </p>
    </header>

    <!-- Pipeline: one track, four stops -->
    <ol class="pipeline" role="list">
      {steps.map((step) => (
        <li class="stop">
          <span class="node" aria-hidden="true"></span>
          <div class="stop-meta">
            <span class="stop-index">{step.index}</span>
            <span class="stop-time">{step.timeframe}</span>
          </div>
          <h3 class="stop-phase">{step.phase}</h3>
          <p class="stop-desc">{step.description}</p>
          <p class="stop-out">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            <span class="sr-only">Outcome: </span>{step.deliverable}
          </p>
        </li>
      ))}
    </ol>

    <!-- Principles: always-visible, no hover required -->
    <div class="principles" data-parallax="-0.03">
      <h3 class="principles-label">Our principles</h3>
      <ul class="principles-list" role="list">
        {principles.map((p) => (
          <li class="principle">
            <span class="principle-icon" set:html={p.icon}></span>
            <div>
              <h4 class="principle-title">{p.title}</h4>
              <p class="principle-body">{p.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  .process-section {
    background: var(--bg);
    position: relative;
    overflow: hidden;
    --node: 14px;
    --track-gap: var(--space-8);
  }

  .section-header {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }

  .header-badge {
    display: inline-block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--text-strong);
    margin-bottom: var(--space-4);
    letter-spacing: -0.03em;
  }

  .section-desc {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── Pipeline ─────────────────────────────────────────── */
  .pipeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--track-gap);
  }

  .stop {
    position: relative;
    padding-top: var(--space-10);
    display: flex;
    flex-direction: column;
  }

  /* Track segment running to the next stop */
  .stop::before {
    content: '';
    position: absolute;
    top: calc(var(--node) / 2 - 1px);
    left: 0;
    right: calc(-1 * var(--track-gap));
    height: 2px;
    background: linear-gradient(90deg, var(--text-strong), var(--border-strong) 40%, var(--border));
  }

  .stop:last-child::before {
    right: auto;
    width: 40%;
    background: linear-gradient(90deg, var(--text-strong), transparent);
  }

  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    background: var(--bg-dark);
    box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px var(--gold-metallic);
    z-index: 1;
    transition: transform var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }

  .stop-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
  }

  .stop-index {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--gold-dark);
    letter-spacing: 0.05em;
  }

  .stop-time {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stop-phase {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: var(--space-2);
  }

  .stop-desc {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex-grow: 1; /* pushes the outcome pill to the bottom so all four align */
  }

  .stop-out {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-strong);
    background: var(--gold-light);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    line-height: 1.5;
  }

  .stop-out svg {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .stop:hover .node {
      transform: scale(1.25);
      background: var(--gold-metallic);
    }
    .stop:hover .stop-out svg {
      transform: translateX(3px);
    }
  }

  /* ── Principles ───────────────────────────────────────── */
  .principles {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .principles-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    padding-top: var(--space-1);
  }

  .principles-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .principle {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .principle-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-md);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-strong);
  }

  .principle-title {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-1);
  }

  .principle-body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 1024px) {
    .principles {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .principles-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  /* Vertical track on tablet/mobile */
  @media (max-width: 768px) {
    .pipeline {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .stop {
      padding-top: 0;
      padding-left: var(--space-10);
    }

    .stop::before,
    .stop:last-child::before {
      top: var(--node);
      left: calc(var(--node) / 2 - 1px);
      right: auto;
      width: 2px;
      height: calc(100% + var(--space-8) - var(--node));
      background: linear-gradient(180deg, var(--text-strong), var(--border));
    }

    .stop:last-child::before {
      height: 40%;
      background: linear-gradient(180deg, var(--text-strong), transparent);
    }

    .node {
      top: 4px;
    }
  }

  @media (max-width: 640px) {
    .section-title {
      font-size: clamp(1.75rem, 8vw, 2.5rem);
    }
    .principles {
      margin-top: var(--space-12);
    }
    .principles-list {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .node,
    .stop-out svg {
      transition: none;
    }
    .stop:hover .node {
      transform: none;
    }
  }
</style>
