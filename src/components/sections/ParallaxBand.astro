---
// Full-bleed dark band: giant outlined words drift sideways at different
// speeds as you scroll, while the statement at the centre drifts the other way.
const rows = [
  { words: ['Secure by design', 'Reviewed', 'Tested'], x: 0.38, tone: 'outline' },
  { words: ['Built to last', 'Maintainable', 'Documented'], x: -0.55, tone: 'ghost' },
  { words: ['Code you can trust', 'Practical', 'Shipped'], x: 0.28, tone: 'outline' },
];
const repeat = (words: string[]) => Array.from({ length: 4 }, () => words).flat();
---

<section class="band" aria-labelledby="band-heading">
  <div class="rows" aria-hidden="true">
    {rows.map((row) => (
      <div class={`row row-${row.tone}`} data-parallax-x={row.x}>
        {repeat(row.words).map((word) => (
          <span class="word">{word}<i class="sep">/</i></span>
        ))}
      </div>
    ))}
  </div>

  <div class="band-center" data-parallax="-0.06">
    <p class="kicker">Our promise</p>
    <h2 id="band-heading" class="statement">Reviewed. Tested. <span>Built to last.</span></h2>
    <a class="band-link" href="#contact">
      Start a project
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    background: var(--bg-dark);
    min-height: clamp(420px, 62vh, 620px);
    display: grid;
    place-items: center;
    padding-block: var(--space-16);
    isolation: isolate;
  }

  .rows {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.25rem, 1.2vw, 1rem);
    z-index: 0;
    user-select: none;
  }

  .row {
    display: flex;
    width: max-content;
    margin-left: -45vw; /* start well off-screen so drifting never exposes an edge */
    white-space: nowrap;
    will-change: translate;
  }

  .word {
    font-family: var(--font-heading);
    font-size: clamp(3.5rem, 11vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
    padding-right: 0.25em;
  }

  .sep {
    font-style: normal;
    margin-left: 0.25em;
    color: var(--text-light);
    opacity: 0.35;
    -webkit-text-stroke: 0;
  }

  .row-outline .word {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.24);
  }

  .row-ghost .word {
    color: rgba(255, 255, 255, 0.07);
    -webkit-text-stroke: 0;
  }

  /* Centre statement, with a soft dark halo so it reads over the words */
  .band-center {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-12) var(--space-8);
    max-width: 720px;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.92) 55%, transparent 100%);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-light-muted);
    margin-bottom: var(--space-4);
  }

  .statement {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: var(--space-8);
  }

  .statement span {
    color: var(--text-light);
  }

  .band-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-strong);
    background: var(--text-light);
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-6);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }

  .band-link svg {
    width: 16px;
    height: 16px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .band-link:hover {
    background: #d4d4d4;
  }

  .band-link:hover svg {
    transform: translateX(3px);
  }

  .band-link:focus-visible {
    outline: 2px solid var(--text-light);
    outline-offset: 3px;
  }
</style>
