---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import GridBackground from '../components/ui/GridBackground.tsx';
import SideGrids from '../components/ui/SideGrids.tsx';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  keywords?: string;
  author?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Software engineering and security-focused development. We build secure software and audit existing systems for vulnerabilities.',
  ogImage = '/og.png',
  canonical,
  noindex = false,
  jsonLd,
  keywords = 'software development, security auditing, code review, web applications, security engineering',
  author = 'KNR Collective',
  ogType = 'website',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'KNR Collective' ? title : `${title} — KNR Collective`;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <meta name="robots" content="index,follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KNR Collective" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} — KNR Collective`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@knrcollective" />
    <meta name="twitter:creator" content="@knrcollective" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} — KNR Collective`} />

    <!-- Additional SEO -->
    <meta name="application-name" content="KNR Collective" />
    <meta name="apple-mobile-web-app-title" content="KNR Collective" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Google Fonts - optimized but reliable loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Load both fonts reliably with display=swap -->
    <link 
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&display=swap"
    />

    <!-- Critical CSS inlined for immediate rendering -->
    <style>
      /* Critical above-the-fold styles */
      * { box-sizing: border-box; }
      
      body { 
        margin: 0; 
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #ffffff;
        color: #1a1a1a;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      
      /* Header critical styles */
      .site-header { 
        position: fixed; 
        top: 0; 
        left: 0; 
        right: 0; 
        z-index: 1000;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
        transition: background-color 0.2s ease;
        border-bottom: 1px solid transparent;
        padding: 1rem 0;
      }
      
      .site-header.scrolled {
        background: rgba(255,255,255,0.98);
        border-bottom-color: rgba(0,0,0,0.1);
      }
      
      /* Hero section critical styles */
      .hero { 
        min-height: 95vh; 
        display: flex; 
        flex-direction: column; 
        justify-content: center;
        padding-top: 100px;
        background: #0a0a0a;
        position: relative;
        overflow: hidden;
      }
      
      .hero-headline {
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: clamp(3.5rem, 10vw, 7.5rem);
        font-weight: 700;
        line-height: 0.9;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.05em;
      }
      
      .hero-sub {
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: clamp(1.125rem, 2vw, 1.5rem);
        color: rgba(255, 255, 255, 0.7);
        line-height: 1.3;
        margin-bottom: 2.5rem;
      }
      
      /* Button critical styles */
      .btn-primary {
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 1rem;
        font-weight: 600;
        background: #ffffff;
        color: #0a0a0a;
        border: none;
        border-radius: 9999px;
        padding: 1rem 2rem;
        min-height: 52px;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        box-shadow: 0 4px 12px rgba(255, 255, 255, 0.15);
      }
      
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(255, 255, 255, 0.25);
      }
      
      /* Critical layout grid */
      :root {
        --container-max-width: 1400px;
      }
      
      .section-container {
        width: 100%;
        max-width: var(--container-max-width);
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 4vw, 4rem);
      }
      
      /* Hero inner layout */
      .hero-inner {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 5rem;
        align-items: center;
        padding-block: 3rem;
        position: relative;
      }
      
      @media (max-width: 900px) {
        .hero-inner {
          grid-template-columns: 1fr;
          gap: 3rem;
        }
      }
      
      /* Visual card positioning */
      .hero-visual {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        min-height: 600px;
      }
      
      .visual-card {
        position: absolute;
        width: 150%;
        max-width: 900px;
        aspect-ratio: 1;
        right: -22%;
        top: 50%;
        transform: translateY(-50%);
      }
      
      .hero-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }
      
      /* Hide visual effects on mobile initially */
      @media (max-width: 768px) {
        canvas[style*="left: 0"],
        canvas[style*="right: 0"] {
          display: none !important;
        }
        
        .hero-visual {
          min-height: 500px;
        }
        
        .visual-card {
          position: relative;
          width: 100%;
          max-width: 600px;
          right: 0;
          left: 0;
          margin: 0 auto;
          top: 0;
          transform: none;
        }
      }
      
      /* Loading states to prevent layout shift */
      .loading-placeholder {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
      }
      
      @keyframes loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
      
      /* Prevent invisible text during font swap */
      .hero-headline, .hero-sub {
        font-display: swap;
      }
      
      /* Header nav critical styles */
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 4vw, 4rem);
      }
      
      .nav-logo {
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        font-size: 1.125rem;
        font-weight: 600;
        color: #000000;
        text-decoration: none;
      }
      
      .nav-links {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 2rem;
      }
      
      .nav-link {
        font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #666666;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: color 0.2s ease;
      }
      
      .nav-link:hover {
        color: #000000;
      }
      
      @media (max-width: 768px) {
        .nav-links {
          display: none;
        }
      }
    </style>

    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])} />
    )}

    <ClientRouter />
  </head>

  <body>
    <!-- Remove no-js class immediately -->
    <script>document.documentElement.classList.remove('no-js');</script>

    <!-- Simple loading indicator for initial page load -->
    <div id="page-loader" style="position:fixed;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,#d4af37 0%,#f4d03f 50%,#d4af37 100%);background-size:200% 100%;animation:loader-animation 2s ease-in-out infinite;z-index:9999;">
    </div>
    <style>
      @keyframes loader-animation {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
    </style>
    <script is:inline>
      // Remove loader when page is fully loaded and make CSS non-render-blocking
      window.addEventListener('load', () => {
        const loader = document.getElementById('page-loader');
        if (loader) {
          loader.style.opacity = '0';
          loader.style.transition = 'opacity 0.3s ease';
          setTimeout(() => loader.remove(), 300);
        }
        
        // Ensure all CSS has loaded properly
        const cssLinks = document.querySelectorAll('link[rel="stylesheet"]');
        cssLinks.forEach(link => {
          if (!link.sheet) {
            console.warn('CSS not loaded:', link.href);
          }
        });
      });
    </script>

    <!-- Animated background (load after page interaction, not just visibility) -->
    <GridBackground client:idle transition:persist />
    
    <!-- Moving pixel grids on sides for white backgrounds (desktop only, load after delay) -->
    <SideGrids client:idle transition:persist />

    <Header />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Global header scroll behavior -->
    <script is:inline>
      function initHeaderScroll() {
        const header = document.getElementById('site-header');
        
        function onScroll() {
          if (!header) return;
          
          const scrolled = window.scrollY > 24;
          
          // Add scrolled class for header background AND show CTA text at the same time
          header.classList.toggle('scrolled', scrolled);
          header.classList.toggle('show-cta-text', scrolled);
        }
        
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll(); // Run once on load
      }

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', initHeaderScroll);
      
      // Re-initialize on Astro page transitions
      document.addEventListener('astro:page-load', initHeaderScroll);
    </script>
  </body>
</html>
