---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import GridBackground from '../components/ui/GridBackground.tsx';
import SideGrids from '../components/ui/SideGrids.tsx';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  keywords?: string;
  author?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Software engineering and security-focused development. We build secure software and audit existing systems for vulnerabilities.',
  ogImage = '/og.png',
  canonical,
  noindex = false,
  jsonLd,
  keywords = 'software development, security auditing, code review, web applications, security engineering',
  author = 'KNR Collective',
  ogType = 'website',
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'KNR Collective' ? title : `${title} — KNR Collective`;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {!noindex && <meta name="robots" content="index,follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KNR Collective" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${title} — KNR Collective`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@knrcollective" />
    <meta name="twitter:creator" content="@knrcollective" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} — KNR Collective`} />

    <!-- Additional SEO -->
    <meta name="application-name" content="KNR Collective" />
    <meta name="apple-mobile-web-app-title" content="KNR Collective" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload critical resources to reduce waterfall -->
    <link rel="preload" href="/_astro/BaseLayout.CGsp29h3.css" as="style" />
    <link rel="preload" href="/_astro/index.WfhOV5Dj.css" as="style" />
    
    <!-- Preload critical JS modules -->
    <link rel="modulepreload" href="/_astro/ClientRouter.astro_ast….BDCjmQ8c.js" />
    <link rel="modulepreload" href="/_astro/client.cE8-S_EN.js" />
    
    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <!-- Defer non-critical background JS -->
    <link rel="prefetch" href="/_astro/GridBackground.DeSzwBcK.js" />
    <link rel="prefetch" href="/_astro/SideGrids.CIGiBcw2.js" />
    <link rel="prefetch" href="/_astro/HalftoneBackground.DtF-jbML.js" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Google Fonts - optimized critical path loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Critical fonts loaded first -->
    <link 
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    
    <!-- Non-critical mono font loaded after -->
    <link 
      rel="prefetch"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
    />
    
    <noscript>
      <link 
        rel="stylesheet" 
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300..700;1,300..700&family=Geist:wght@300..700&display=swap"
      />
    </noscript>

    <!-- Critical CSS inlined for immediate rendering -->
    <style>
      /* Critical above-the-fold styles */
      * { box-sizing: border-box; }
      body { 
        margin: 0; 
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #ffffff;
        color: #1a1a1a;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .site-header { 
        position: fixed; 
        top: 0; 
        left: 0; 
        right: 0; 
        z-index: 1000;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
        transition: background-color 0.2s ease;
      }
      .hero { 
        min-height: 95vh; 
        display: flex; 
        flex-direction: column; 
        justify-content: center;
        padding-top: 100px;
        background: #0a0a0a;
        position: relative;
        overflow: hidden;
      }
      .hero-headline {
        font-size: clamp(3.5rem, 10vw, 7.5rem);
        font-weight: 700;
        line-height: 0.9;
        color: #ffffff;
        margin-bottom: 2rem;
        letter-spacing: -0.05em;
      }
      /* Critical layout grid */
      .section-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 4vw, 4rem);
      }
      /* Hide visual effects on mobile initially */
      @media (max-width: 768px) {
        canvas[style*="left: 0"],
        canvas[style*="right: 0"] {
          display: none !important;
        }
      }
      /* Loading states */
      .loading-placeholder {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
      }
      @keyframes loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
    </style>

    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])} />
    )}

    <ClientRouter />
  </head>

  <body>
    <!-- Remove no-js class immediately -->
    <script>document.documentElement.classList.remove('no-js');</script>

    <!-- Simple loading indicator for initial page load -->
    <div id="page-loader" style="position:fixed;top:0;left:0;width:100%;height:3px;background:linear-gradient(90deg,#d4af37 0%,#f4d03f 50%,#d4af37 100%);background-size:200% 100%;animation:loader-animation 2s ease-in-out infinite;z-index:9999;">
    </div>
    <style>
      @keyframes loader-animation {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }
    </style>
    <script is:inline>
      // Remove loader when page is fully loaded
      window.addEventListener('load', () => {
        const loader = document.getElementById('page-loader');
        if (loader) {
          loader.style.opacity = '0';
          loader.style.transition = 'opacity 0.3s ease';
          setTimeout(() => loader.remove(), 300);
        }
      });
    </script>

    <!-- Animated background (non-critical, load after interaction) -->
    <GridBackground client:media="(min-width: 768px)" transition:persist />
    
    <!-- Moving pixel grids on sides for white backgrounds (desktop only, non-critical) -->
    <SideGrids client:media="(min-width: 768px)" transition:persist />

    <Header />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Global header scroll behavior -->
    <script is:inline>
      function initHeaderScroll() {
        const header = document.getElementById('site-header');
        
        function onScroll() {
          if (!header) return;
          
          const scrolled = window.scrollY > 24;
          
          // Add scrolled class for header background AND show CTA text at the same time
          header.classList.toggle('scrolled', scrolled);
          header.classList.toggle('show-cta-text', scrolled);
        }
        
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll(); // Run once on load
      }

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', initHeaderScroll);
      
      // Re-initialize on Astro page transitions
      document.addEventListener('astro:page-load', initHeaderScroll);
    </script>
  </body>
</html>
