---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allWork = await getCollection('work');
const sorted = allWork.sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout
  title="Work"
  description="Case studies and projects from KNR Collective — web applications, internal tools, and infrastructure."
>
  <div class="work-page">
    <div class="section-container">

      <header class="page-header">
        <a href="/" class="back-link">← KNR/</a>
        <div class="page-header-inner">
          <span class="page-index" aria-hidden="true">03</span>
          <h1 class="page-title">Work</h1>
        </div>
        <p class="page-desc">
          Projects we've shipped. Client names omitted unless we have explicit permission to publish.
        </p>
      </header>

      {sorted.length === 0 ? (
        <div class="empty-state">
          <p>Case studies coming soon. <a href="/#contact">Get in touch</a> to hear about our work directly.</p>
        </div>
      ) : (
        <ul class="work-list" role="list">
          {sorted.map((project) => (
            <li class="work-item">
              <a
                href={`/work/${project.data.slug}`}
                class="work-link"
                aria-label={`View case study: ${project.data.title}`}
              >
                <div class="work-meta-row">
                  <span class="work-type">{project.data.type}</span>
                  <span class="work-year">{project.data.year}</span>
                </div>
                <div class="work-body">
                  <div class="work-info">
                    <h2 class="work-title">{project.data.title}</h2>
                    <p class="work-client">{project.data.client}</p>
                    <p class="work-problem">{project.data.problem}</p>
                  </div>
                  <span class="work-arrow" aria-hidden="true">→</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}

    </div>
  </div>
</BaseLayout>

<style>
  .work-page {
    padding-top: calc(56px + var(--space-16));
    padding-bottom: var(--space-24);
    min-height: 100svh;
  }

  .page-header {
    margin-bottom: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
    align-self: flex-start;
  }
  .back-link:hover { color: var(--text-strong); }

  .page-header-inner {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
  }

  .page-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .page-title {
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
  }

  .page-desc {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 60ch;
  }

  /* ── Work list ───────────────────────────────────── */
  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work-item {
    border-top: 1px solid var(--border);
  }
  .work-item:last-child { border-bottom: 1px solid var(--border); }

  .work-link {
    display: block;
    padding: var(--space-8) 0;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .work-link:hover { background: rgba(255,255,255,0.015); }
  .work-link:hover .work-title { color: var(--text-strong); }
  .work-link:hover .work-arrow { opacity: 1; transform: translateX(0); }

  .work-meta-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .work-body {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .work-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .work-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text);
    transition: color var(--dur-fast) var(--ease-out);
    letter-spacing: -0.02em;
  }

  .work-client {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: none;
  }

  .work-problem {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 65ch;
    margin-top: var(--space-1);
  }

  .work-arrow {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--text-strong);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
    flex-shrink: 0;
  }

  .empty-state {
    border: 1px solid var(--border);
    padding: var(--space-12);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .empty-state a {
    color: var(--text-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 600px) {
    .work-arrow { display: none; }
  }
</style>
